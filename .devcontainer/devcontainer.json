{
  "name": "MarketPulse Platform",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "api/main.py",
        "frontend/src/App.jsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && cd frontend && npm install",
  "postAttachCommand": "echo '✅ Environment ready! Run: uvicorn api.main:app --reload (for API) and cd frontend && npm run dev (for UI)'",
  "portsAttributes": {
    "5173": {
      "label": "Frontend (React)",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "Backend API (FastAPI)",
      "onAutoForward": "ignore"
    }
  },
  "forwardPorts": [
    5173,
    8000
  ]
}