//@version=6
// ══════════════════════════════════════════════════════════════════════
// ██╗███████╗███╗   ███╗███████╗    ██╗   ██╗██████╗
// ██║██╔════╝████╗ ████║██╔════╝    ██║   ██║╚════██╗
// ██║███████╗██╔████╔██║█████╗      ██║   ██║ █████╔╝
// ██║╚════██║██║╚██╔╝██║██╔══╝      ╚██╗ ██╔╝██╔═══╝
// ██║███████║██║ ╚═╝ ██║███████╗     ╚████╔╝ ███████╗
// ╚═╝╚══════╝╚═╝     ╚═╝╚══════╝      ╚═══╝  ╚══════╝
//
// Institutional Stage Momentum Engine (ISME) v2
// A multi-factor swing-trading indicator combining Minervini-style
// stage analysis, institutional activity detection, relative strength
// ranking, and quarterly financial validation.
//
// ── v2 ENHANCEMENTS ─────────────────────────────────────────────────
// • Position State Machine — ENTRY / HOLD / ADD / TIGHTEN / REDUCE / EXIT
// • Risk-Reward Box — visual entry, stop-loss, 2R and 3R target zones
// • Monthly Timeframe Confirmation — validates weekly signals against
//   the monthly trend for higher-conviction entries
// • RS Percentile Ranking — shows where RS sits in its 1-year history
// • VCP Detection — Volatility Contraction Pattern (Minervini base)
// • Earnings Proximity Warning — flags imminent earnings risk
//
// ── HOW TO USE ──────────────────────────────────────────────────────
// • Apply to any NSE/BSE equity on Daily or Weekly timeframe.
// • The POSITION row (top of summary table) tells you the action:
//   🟢 ENTRY/ADD  🔵 HOLD  🟡 TIGHTEN  🟠 REDUCE  🔴 EXIT
// • The background color (green/red) shows whether the stock is
//   outperforming or underperforming the benchmark (RS vs RS EMA).
// • Use the Summary Table for an at-a-glance scorecard.
// • Use the Fundamentals Table for quarterly NP/Sales/OPM data.
// • Enable "Show Signal Legend" to see what every marker means.
//
// ── SIGNAL REFERENCE ────────────────────────────────────────────────
//  BUY A  — Trend alignment breakout (EMA stack + RSI + ADX)  [40 pts]
//  BUY B  — Donchian 20-day channel breakout + volume surge   [30 pts]
//  BUY C  — 52-week high breakout + RS outperformance         [30 pts]
//  STRONG — Combined score ≥ 70, highest-conviction signal
//  SELL X — Momentum loss (below EMA20 + RSI < 45)
//  SELL Y — Trend weakness (below EMA50 + RS < RS EMA)
//  SELL Z — Trend breakdown (below EMA200 + strong ADX)
//  VCP   — Volatility Contraction Pattern base detected
//
// ── STAGE ANALYSIS ──────────────────────────────────────────────────
//  Stage 1 — Basing: price above EMA200, flat 200-day MA
//  Stage 2 — Advancing: price above EMA150, EMA150 > EMA200, rising
//  Stage 3 — Distribution: price below EMA150 but above EMA200
//  Stage 4 — Declining: everything else
//
// ── NON-REPAINTING ──────────────────────────────────────────────────
// All signals use confirmed bar data only. request.security calls use
// lookahead=barmerge.lookahead_off. The 52-week high excludes the
// current bar (high[1]). All triggers are state-transition based
// (fire once on the bar the condition first becomes true).
//
// ── DISCLAIMER ──────────────────────────────────────────────────────
// This indicator is for educational and informational purposes only.
// It does not constitute financial advice. Past performance is not
// indicative of future results. Always do your own research before
// making trading decisions.
//
// Made with ❤️
// ══════════════════════════════════════════════════════════════════════

indicator("Institutional Stage Momentum Engine (ISME) v2", shorttitle="ISME v2", overlay=true, max_labels_count=500, max_bars_back=500)

//====================================================
// INPUTS
//====================================================
lengthADX     = input.int(14, "Length ADX", group="Trend & Momentum", tooltip="Period for Average Directional Index calculation. Higher values smooth the trend strength reading.")
thresholdADX  = input.int(14, "Threshold ADX", group="Trend & Momentum", tooltip="Minimum ADX value required for trend confirmation. Signals below this are considered choppy.")

lengthRSI     = input.int(14, "Length RSI", group="Trend & Momentum", tooltip="Period for Relative Strength Index. Standard is 14.")

sarStart      = input.float(0.02, "SAR Start", group="Parabolic SAR", tooltip="Initial acceleration factor for Parabolic SAR. Lower values create a tighter trailing stop.")
sarInc        = input.float(0.02, "SAR Increment", group="Parabolic SAR", tooltip="Increment added to SAR acceleration factor after each new extreme. Controls how quickly SAR catches up.")
sarMax        = input.float(0.2, "SAR Max Value", group="Parabolic SAR", tooltip="Maximum acceleration factor for SAR. Caps how aggressively the stop tightens.")

rsSymbol      = input.symbol("NSE:NIFTY", "RS Index", group="Relative Strength", tooltip="Benchmark index for Relative Strength calculation. Default is NSE:NIFTY for Indian markets. Change to SPX for US markets.")
rsMAPeriod    = input.int(10, "RS MA Period", group="Relative Strength", tooltip="EMA period applied to the RS ratio line. Shorter periods react faster to RS changes.")

showMTF       = input.bool(true, "Monthly Confirmation", group="Multi-Timeframe", tooltip="Enable monthly timeframe trend validation. Weekly buy signals are stronger when the monthly trend agrees.")

showSAR       = input.bool(true, "Show Parabolic SAR", group="Display", tooltip="Toggle Parabolic SAR dots on the chart.")
showInsider   = input.bool(true, "Show Insider Activity", group="Display", tooltip="Toggle insider/institutional activity detection labels (ACC, DIST, Stealth).")
showVCP       = input.bool(true, "Show VCP Setups", group="Display", tooltip="Detect Volatility Contraction Patterns — classic Minervini base setups before breakouts.")
showRR        = input.bool(true, "Show Risk/Reward", group="Display", tooltip="Display risk-reward zones with entry, stop, and target levels on the chart.")
showLegend    = input.bool(false, "Show Signal Legend", group="Display", tooltip="Show a detailed signal legend table explaining all markers and signals.")
tableFontSize = input.string("Normal", "Table Font Size", options=["Tiny", "Small", "Normal", "Large"], group="Display", tooltip="Font size for all on-chart tables. Use 'Tiny' for mobile devices.")

// Table position settings
summaryPos    = input.string("Top Right", "Summary Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Table Positions", tooltip="Position of the main summary table showing Stage, Score, RS, ADX, RSI, and financials.")
fundPos       = input.string("Bottom Right", "Fundamentals Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Table Positions", tooltip="Position of the quarterly fundamentals table showing NP, Sales, OPM data.")
legendPos     = input.string("Bottom Left", "Legend Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Table Positions", tooltip="Position of the signal legend reference table.")

fontSize = tableFontSize == "Tiny" ? size.tiny : tableFontSize == "Small" ? size.small : tableFontSize == "Large" ? size.large : size.normal
// Legend table always one step smaller than main tables for compact fit
legendSize = tableFontSize == "Tiny" ? size.tiny : tableFontSize == "Small" ? size.tiny : tableFontSize == "Large" ? size.normal : size.small

// Helper: convert position string to Pine position constant
f_pos(string p) =>
    p == "Top Left" ? position.top_left : p == "Top Right" ? position.top_right : p == "Bottom Left" ? position.bottom_left : position.bottom_right

//====================================================
// CORE CALCULATIONS
//====================================================

// EMAs
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema150 = ta.ema(close, 150)
ema200 = ta.ema(close, 200)

// RSI
rsi = ta.rsi(close, lengthRSI)

// ADX — extracted to global scope to avoid Pine v6 lazy-eval issues
[diplus, diminus, adx] = ta.dmi(lengthADX, lengthADX)

// ATR
atr = ta.atr(14)

// SAR — now actually plotted (was computed but wasted before)
psar = ta.sar(sarStart, sarInc, sarMax)

// Donchian
donHigh = ta.highest(high, 20)
donLow  = ta.lowest(low, 20)

// 52 Week High (NO REPAINT — uses high[1] to exclude current bar)
high52 = ta.highest(high[1], 252)

// Volume Average
volMA = ta.sma(volume, 20)

//====================================================
// RELATIVE STRENGTH
//====================================================
indexClose = request.security(rsSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off)

rs = not na(indexClose) and indexClose > 0 ? close / indexClose : na

rsEMA = ta.ema(rs, rsMAPeriod)

// RS Percentile Rank (0-100: where RS sits in its 1-year history)
rsRank = ta.percentrank(rs, 252)

//====================================================
// MONTHLY TIMEFRAME CONFIRMATION
//====================================================
[mTrendOk, mStage2ok] = request.security(syminfo.tickerid, "M",
    [ta.ema(close, 10) > ta.ema(close, 40),
     close > ta.ema(close, 30) and ta.ema(close, 30) > ta.ema(close, 40)],
    lookahead=barmerge.lookahead_off)

monthlyAligned = not showMTF or (mTrendOk and mStage2ok)
string monthlyLabel = not showMTF ? "OFF" : monthlyAligned ? "✅ ALIGNED" : "⚠ DIVERGENT"

//====================================================
// BACKGROUND COLOR (RS)
//====================================================
bgBull = rs > rsEMA

bgcolor(bgBull ? color.new(#00E676, 82) : color.new(#FF1744, 82))

//====================================================
// MA CROSSOVER BAND (fill between EMAs — no Y-axis stretch)
//====================================================
bullBand = ema20 > ema50

p_ema20 = plot(ema20, color=color.new(color.aqua, 60), linewidth=1, title="EMA 20")
p_ema50 = plot(ema50, color=color.new(color.orange, 60), linewidth=1, title="EMA 50")

fill(p_ema20, p_ema50,
     color = bullBand ? color.new(color.lime, 85) : color.new(color.red, 85),
     title = "MA Band Fill"
)

//====================================================
// MINERVINI TREND TEMPLATE
//====================================================
trendTemplate = (
    close > ema50 and
    close > ema150 and
    close > ema200 and
    ema50 > ema150 and
    ema150 > ema200
)

//====================================================
// STOCK BEHAVIOR TYPE CLASSIFIER (chart-based component)
//====================================================
// Chart metrics (computed early, financial blend added after quarterly data)
float bVol      = ta.stdev(close, 100) / close * 100
float bMaxDD    = (ta.highest(close, 252) - ta.lowest(close, 252)) / ta.highest(close, 252) * 100
float trendPersist = ta.sma(close > ema50 ? 1.0 : 0.0, 100) * 100
float rsBonus      = not na(rs) and not na(rsEMA) and rs > rsEMA ? 20.0 : 0.0
float growthRate   = (close - close[100]) / close[100] * 100
float slopeShort   = ta.linreg(close, 20, 0)
float slopeLong    = ta.linreg(close, 100, 0)
float slopeChange  = slopeShort - slopeLong
float baseBreak    = close > ta.highest(close, 60)[1] ? 30.0 : 0.0

// Chart-only raw scores (0-100)
float chartCyclical  = math.min(bVol * 3 + bMaxDD, 100)
float chartGrowth    = math.min(trendPersist + rsBonus, 100)
float chartDefensive = math.min(math.max(100 - bVol * 5 - math.abs(growthRate), 0), 100)
float chartTurnaround = math.min(math.max(slopeChange / atr * 10 + baseBreak, 0), 100)

// Final blended scores (updated after financial data)
var float cyclicalScore  = 0.0
var float growthScore    = 0.0
var float defensiveScore = 0.0
var float turnaroundScore = 0.0
var string behavType = "--"
var color behavClr = color.gray
var float maxBehav = 0.0

//====================================================
// MARKET REGIME FILTER
//====================================================
trendOk = adx > 18 and ema50 > ema200

// Cooldown: prevent signal spam (5-bar minimum gap)
var int lastBuyBar = 0
cooldownOk = bar_index - lastBuyBar >= 5
buyAllowed = trendOk and cooldownOk

//====================================================
// BUY CONDITIONS (STATE → TRIGGER, regime-gated)
//====================================================
buyA_state = (
    close > ema20 and
    ema20 > ema50 and
    rsi > 55 and
    adx > thresholdADX and
    trendTemplate
)
buyA_raw = buyA_state and not buyA_state[1]
buyA = buyA_raw and buyAllowed

// B = Donchian breakout (clean crossover)
buyB_raw = ta.crossover(close, ta.highest(high, 20)[1]) and volume > volMA
buyB = buyB_raw and buyAllowed

// C = 52W High breakout
buyC_state = (
    close >= high52 and
    not na(rs) and rs > rsEMA
)
buyC_raw = buyC_state and not buyC_state[1]
buyC = buyC_raw and buyAllowed

//====================================================
// WEIGHTED INSTITUTIONAL SCORING (0-100)
//====================================================
wScore = (buyA_state ? 40.0 : 0.0) + (buyB_raw ? 30.0 : 0.0) + (buyC_state ? 30.0 : 0.0)

// Monthly timeframe score modifier (boost aligned, penalize counter-trend)
if showMTF
    float monthlyBonus = 0.0
    if monthlyAligned
        monthlyBonus += 10
    if mTrendOk
        monthlyBonus += 5
    if mStage2ok
        monthlyBonus += 5
    wScore += monthlyBonus
    if not monthlyAligned
        wScore -= 10

strongBuy_state = wScore >= 70
strongBuy_raw = strongBuy_state and not strongBuy_state[1]
strongBuy = strongBuy_raw and buyAllowed

// Cooldown only applies to STRONG BUY clustering (A/B/C signals fire independently)
if strongBuy
    lastBuyBar := bar_index

// Signal hierarchy: suppress A/B/C when STRONG fires
showA = buyA and not strongBuy
showB = buyB and not strongBuy
showC = buyC and not strongBuy

//====================================================
// SELL CONDITIONS (always fire — never suppress risk signals)
//====================================================
sellX_state = close < ema20 and rsi < 45
sellX_raw = sellX_state and not sellX_state[1]

sellY_state = close < ema50 and not na(rs) and rs < rsEMA
sellY_raw = sellY_state and not sellY_state[1]

sellZ_state = close < ema200 and adx > thresholdADX
sellZ = sellZ_state and not sellZ_state[1]

// Sell hierarchy: suppress X/Y when Z fires
sellX = sellX_raw and not sellZ
sellY = sellY_raw and not sellZ

//====================================================
// STAGE ANALYSIS (defined early — used by VCP + Table)
//====================================================

// Stage 2 = Advancing (most specific — checked first)
stage2 = (
    close > ema150 and
    ema150 > ema200 and
    ta.rising(ema200, 20)
)

// Stage 1 = Base (explicitly NOT Stage 2)
stage1 = (
    not stage2 and
    close > ema200 and
    not ta.rising(ema200, 10) and
    not ta.falling(ema200, 10)
)

// Stage 3 = Distribution (explicitly NOT Stage 1 or 2)
stage3 = (
    not stage2 and not stage1 and
    close < ema150 and
    close > ema200
)

// Stage 4 = Everything else (declining)
stage4 = not stage2 and not stage1 and not stage3

// Stage text and color
stageText =
     stage2 ? "STAGE 2 - ADVANCING" :
     stage1 ? "STAGE 1 - BASE" :
     stage3 ? "STAGE 3 - DISTRIBUTION" :
     "STAGE 4 - DECLINING"

stageColor =
     stage2 ? color.green :
     stage1 ? color.gray :
     stage3 ? color.orange :
     color.red

//====================================================
// VCP (VOLATILITY CONTRACTION PATTERN) DETECTION
//====================================================
atrShort   = ta.atr(5)
atrRef     = ta.atr(5)[10]
vcpATR     = not na(atrRef) and atrRef > 0 and atrShort < atrRef * 0.6

rangeShort = ta.highest(high, 5) - ta.lowest(low, 5)
rangeLong  = ta.highest(high, 20) - ta.lowest(low, 20)
vcpRange   = not na(rangeLong) and rangeLong > 0 and rangeShort < rangeLong * 0.5

vcpSetup   = vcpATR and vcpRange and stage2 and close > ema50
vcpTrigger = vcpSetup and not vcpSetup[1]

//====================================================
// POSITION STATE MACHINE
//====================================================
// Tracks continuous position state for weekly investors:
// NONE → ENTRY → HOLD → ADD/TIGHTEN → REDUCE → EXIT → NONE
var string posState = "NONE"
var int stateStartBar = 0

// Any buy signal fired this bar (used for transitions)
bool anyBuySignal = strongBuy or showA or showB or showC

// Priority-based state transitions (highest priority first)
if sellZ or sellY
    posState := "EXIT"
else if posState != "NONE" and sellX
    posState := "REDUCE"
else if strongBuy
    posState := posState == "NONE" ? "ENTRY" : "ADD"
else if posState == "NONE" and (showA or showB or showC)
    posState := "ENTRY"
else if (posState == "HOLD" or posState == "TIGHTEN") and (showA or showB or showC)
    posState := "ADD"
else if posState == "ENTRY" or posState == "ADD"
    // Persist ENTRY/ADD for 3 bars so weekly investors can see the signal
    if bar_index - stateStartBar >= 3
        posState := "HOLD"
else if posState == "EXIT"
    posState := "NONE"
else if posState == "REDUCE"
    if close > ema50 and trendOk
        posState := "HOLD"
    else if bar_index - stateStartBar >= 5
        // Stuck in REDUCE too long without recovery — force exit
        posState := "EXIT"
else if posState == "HOLD"
    // Tighten when early warnings appear
    bool shouldTighten = false
    if close < ema20 and close > ema50
        shouldTighten := true
    if not na(rs) and not na(rsEMA) and rs < rsEMA and rs[1] >= rsEMA[1]
        shouldTighten := true
    if adx < 15 and adx[1] >= 15
        shouldTighten := true
    if shouldTighten
        posState := "TIGHTEN"
else if posState == "TIGHTEN"
    // Recover to HOLD if conditions improve
    if close > ema20 and (na(rs) or rs > rsEMA)
        posState := "HOLD"

// Track state transitions for persistence and timeout timing
if posState != posState[1]
    stateStartBar := bar_index

// State colors
color posClr = switch posState
    "ENTRY"   => color.new(#00E676, 0)
    "ADD"     => color.new(#00E676, 0)
    "HOLD"    => color.new(#2196F3, 0)
    "TIGHTEN" => color.new(#FFD740, 0)
    "REDUCE"  => color.new(#FF9100, 0)
    "EXIT"    => color.new(#FF1744, 0)
    => color.new(#9E9E9E, 0)

// State emoji for table
string posEmoji = switch posState
    "ENTRY"   => "🟢"
    "ADD"     => "🟢"
    "HOLD"    => "🔵"
    "TIGHTEN" => "🟡"
    "REDUCE"  => "🟠"
    "EXIT"    => "🔴"
    => "⚪"

//====================================================
// RISK-REWARD TRACKING
//====================================================
var float entryPrice = na
var float entryStop  = na

// Capture entry price and stop on ENTRY transition only (prevent overwrite)
if posState == "ENTRY" and posState[1] != "ENTRY"
    entryPrice := close
    entryStop  := ta.lowest(low, 10)

// Update stop to trail higher (never lower) while in position
// TIGHTEN uses a shorter lookback (5 bars) for more aggressive trailing
if posState == "HOLD" or posState == "ADD" or posState == "TIGHTEN"
    float newStop = posState == "TIGHTEN" ? ta.lowest(low, 5) : ta.lowest(low, 10)
    if not na(entryStop) and newStop > entryStop
        entryStop := newStop

// Reset on exit
if posState == "NONE"
    entryPrice := na
    entryStop  := na

// Calculate risk-reward metrics
float riskAmt  = not na(entryPrice) and not na(entryStop) ? entryPrice - entryStop : na
float riskPct  = not na(riskAmt) and entryPrice > 0 ? riskAmt / entryPrice * 100 : na
float target2R = not na(entryPrice) and not na(riskAmt) and riskAmt > 0 ? entryPrice + riskAmt * 2 : na
float target3R = not na(entryPrice) and not na(riskAmt) and riskAmt > 0 ? entryPrice + riskAmt * 3 : na
float currentR = not na(riskAmt) and riskAmt > 0 ? (close - entryPrice) / riskAmt : na

//====================================================
// STRUCTURE-BASED STOP (swing low — more institutional than ATR)
//====================================================
longStop = ta.lowest(low, 10)

plot(
     longStop,
     color=color.new(color.red, 30),
     linewidth=1,
     style=plot.style_stepline,
     title="Swing Stop"
)

//====================================================
// PARABOLIC SAR (now actually plotted)
//====================================================
plot(
     showSAR ? psar : na,
     style=plot.style_cross,
     color=close > psar ? color.green : color.red,
     linewidth=1,
     title="Parabolic SAR"
)

//====================================================
// RS NEW HIGH (FIX: exclude current bar + first-occurrence only)
//====================================================
rsHighPrev  = ta.highest(rs[1], 100)
rsHigh      = rs >= rsHighPrev and rs[1] < rsHighPrev[1]

plotshape(
     rsHigh,
     title="RS High",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.purple,
     size=size.small
)

//====================================================
// BUY SHAPES (now trigger-based — fire once, not every bar)
//====================================================
plotshape(
     showA,
     title="BUY A",
     text="A",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white,
     size=size.small
)

plotshape(
     showB,
     title="BUY B",
     text="B",
     style=shape.labelup,
     location=location.belowbar,
     color=color.lime,
     textcolor=color.black,
     size=size.small
)

plotshape(
     showC,
     title="BUY C",
     text="C",
     style=shape.labelup,
     location=location.belowbar,
     color=color.teal,
     textcolor=color.white,
     size=size.small
)

plotshape(
     strongBuy,
     title="STRONG BUY",
     text="STRONG",
     style=shape.labelup,
     location=location.belowbar,
     color=color.blue,
     textcolor=color.white,
     size=size.normal
)

//====================================================
// SELL SHAPES (now trigger-based)
//====================================================
plotshape(
     sellX,
     title="SELL X",
     text="X",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.small
)

plotshape(
     sellY,
     title="SELL Y",
     text="Y",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.maroon,
     textcolor=color.white,
     size=size.small
)

plotshape(
     sellZ,
     title="SELL Z",
     text="Z",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.orange,
     textcolor=color.white,
     size=size.small
)

//====================================================
// VCP SHAPE (Volatility Contraction Pattern)
//====================================================
plotshape(
     showVCP and vcpTrigger,
     title="VCP Setup",
     text="VCP\n🔷",
     style=shape.labelup,
     location=location.belowbar,
     color=color.new(#2196F3, 0),
     textcolor=color.white,
     size=size.small
)

//====================================================
// DONCHIAN DOT (FIX: first-occurrence trigger only)
//====================================================
donBreak = ta.crossover(close, ta.highest(high, 20)[1])

plotshape(
     donBreak,
     title="Donchian",
     style=shape.diamond,
     location=location.abovebar,
     color=color.orange,
     size=size.small
)

//====================================================
// 52W HIGH FLAG (FIX: first-occurrence trigger only)
//====================================================
newHigh52 = close >= high52 and close[1] < ta.highest(high[2], 252)

plotshape(
     newHigh52,
     title="52W High",
     text="52W\n🔥",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.new(#FFD700, 0),
     textcolor=color.black,
     size=size.normal
)

//====================================================
// RISK-REWARD BOX (visual entry/stop/target zones)
//====================================================
var box  rrBox     = na
var line t2rLine   = na
var line t3rLine   = na
var label t2rLabel = na
var label t3rLabel = na
var label entLabel = na

if barstate.islast
    box.delete(rrBox)
    line.delete(t2rLine)
    line.delete(t3rLine)
    label.delete(t2rLabel)
    label.delete(t3rLabel)
    label.delete(entLabel)

    if showRR and posState != "NONE" and not na(entryPrice) and not na(entryStop) and entryPrice > entryStop
        int boxLeft  = bar_index - 10
        int boxRight = bar_index + 5

        // Red risk zone (entry to stop)
        rrBox := box.new(boxLeft, entryPrice, boxRight, entryStop,
            bgcolor=color.new(color.red, 88), border_color=color.new(color.red, 50), border_width=1)

        // Entry line label
        entLabel := label.new(boxRight, entryPrice, "Entry " + str.tostring(entryPrice, "#.##"),
            style=label.style_label_left, color=color.new(#2196F3, 70), textcolor=color.white, size=size.tiny)

        // 2R target line
        if not na(target2R)
            t2rLine := line.new(boxLeft, target2R, boxRight, target2R,
                color=color.new(color.green, 30), style=line.style_dashed, width=1)
            t2rLabel := label.new(boxRight, target2R, "2R " + str.tostring(target2R, "#.##"),
                style=label.style_label_left, color=color.new(color.green, 70), textcolor=color.white, size=size.tiny)

        // 3R target line
        if not na(target3R)
            t3rLine := line.new(boxLeft, target3R, boxRight, target3R,
                color=color.new(#00E676, 30), style=line.style_dashed, width=1)
            t3rLabel := label.new(boxRight, target3R, "3R " + str.tostring(target3R, "#.##"),
                style=label.style_label_left, color=color.new(#00E676, 70), textcolor=color.white, size=size.tiny)

//====================================================
// STAGE LABEL
//====================================================
var label stageLabel = na

if barstate.islast
    label.delete(stageLabel)

    stageLabel := label.new(
         bar_index,
         high + atr * 3,
         stageText,
         style=label.style_label_down,
         color=stageColor,
         textcolor=color.white,
         size=size.normal
    )

//====================================================
// FINANCIAL DATA (FIX: use ticker.standard + ignore_invalid_symbol)
//====================================================
string cleanTicker = ticker.standard(syminfo.tickerid)

revenue = request.financial(
     cleanTicker,
     "TOTAL_REVENUE",
     "FQ",
     ignore_invalid_symbol=true
)

profit = request.financial(
     cleanTicker,
     "NET_INCOME",
     "FQ",
     ignore_invalid_symbol=true
)

// Shares outstanding for Market Cap & Free Float (more reliable than MARKET_CAP for NSE)
totalShares = request.financial(
     cleanTicker,
     "TOTAL_SHARES_OUTSTANDING",
     "FQ",
     ignore_invalid_symbol=true
)

floatShares = request.financial(
     cleanTicker,
     "FLOAT_SHARES_OUTSTANDING",
     "FQ",
     ignore_invalid_symbol=true
)

operIncome = request.financial(
     cleanTicker,
     "OPER_INCOME",
     "FQ",
     ignore_invalid_symbol=true
)

// Compute Market Cap & Free Float from price × shares (always up-to-date)
float marketCap = not na(totalShares) ? close * totalShares : na
float freeFloat = not na(floatShares) ? close * floatShares : na

//====================================================
// QUARTERLY DATA TRACKING (9 quarters for full YoY on all 5 rows)
//====================================================
CRORE = 10000000.0

var float[] q_np    = array.new_float(9, na)
var float[] q_sales = array.new_float(9, na)
var float[] q_oi    = array.new_float(9, na)
var string[] q_lbl  = array.new_string(9, "")
var float prevRev   = na
var int lastQtrBar  = 0

// Detect quarter boundary: revenue changes or first non-na value
if not na(revenue) and (na(prevRev) or revenue != prevRev)
    array.unshift(q_np, profit)
    array.pop(q_np)
    array.unshift(q_sales, revenue)
    array.pop(q_sales)
    array.unshift(q_oi, operIncome)
    array.pop(q_oi)
    // Approximate FQ-end label from reporting month (Indian FY: Apr-Mar)
    int m = month
    int y = year
    int fqM = m <= 2 ? 12 : m <= 5 ? 3 : m <= 8 ? 6 : m <= 11 ? 9 : 12
    int fqY = fqM == 12 and m <= 2 ? y - 1 : y
    string ms = fqM == 3 ? "Mar" : fqM == 6 ? "Jun" : fqM == 9 ? "Sep" : "Dec"
    array.unshift(q_lbl, ms + "-" + str.tostring(fqY % 100))
    array.pop(q_lbl)
    prevRev := revenue
    lastQtrBar := bar_index

//====================================================
// EARNINGS PROXIMITY WARNING
//====================================================
// Timeframe-aware: weekly ~13 bars/quarter, daily ~63 bars/quarter
int barsSinceQtr = bar_index - lastQtrBar
bool isWeeklyTF = timeframe.isweekly
int earningsThreshLo = isWeeklyTF ? 10 : 50   // 10 weeks or ~50 trading days
int earningsThreshHi = isWeeklyTF ? 15 : 75   // 15 weeks or ~75 trading days
bool earningsSoon = lastQtrBar > 0 and barsSinceQtr >= earningsThreshLo and barsSinceQtr <= earningsThreshHi

// Latest QoQ/YoY for the summary table
float salesGrowth = na
float profitGrowth = na
if not na(array.get(q_sales, 0)) and not na(array.get(q_sales, 1)) and array.get(q_sales, 1) != 0
    salesGrowth := ((array.get(q_sales, 0) - array.get(q_sales, 1)) / math.abs(array.get(q_sales, 1))) * 100
if not na(array.get(q_np, 0)) and not na(array.get(q_np, 1)) and array.get(q_np, 1) != 0
    profitGrowth := ((array.get(q_np, 0) - array.get(q_np, 1)) / math.abs(array.get(q_np, 1))) * 100

//====================================================
// FINANCIAL VALIDATION FOR BEHAVIOR TYPE (blend with chart)
//====================================================
// Count rising quarters (NP & Sales) for consistency checks
float finGrowthBonus    = 0.0
float finCyclicalBonus  = 0.0
float finDefensiveBonus = 0.0
float finTurnaroundBonus = 0.0

// Check NP trend across available quarters
int npRising  = 0
int npFalling = 0
int npSwings  = 0
bool npRecovery = false

for i = 0 to 3
    float curr = array.get(q_np, i)
    float prev = array.get(q_np, i + 1)
    if not na(curr) and not na(prev)
        if curr > prev
            npRising += 1
        else
            npFalling += 1
        // Detect erratic swings (sign changes)
        if (curr > 0 and prev < 0) or (curr < 0 and prev > 0)
            npSwings += 1

// NP recovery from loss (latest positive, older negative)
float npLatest = array.get(q_np, 0)
float npOldest = array.get(q_np, 4)
if not na(npLatest) and not na(npOldest) and npLatest > 0 and npOldest < 0
    npRecovery := true

// Check Sales trend consistency
int salesRising = 0
for i = 0 to 3
    float curr = array.get(q_sales, i)
    float prev = array.get(q_sales, i + 1)
    if not na(curr) and not na(prev) and curr > prev
        salesRising += 1

// Growth: NP rising consistently + Sales expanding (>15% YoY implied)
finGrowthBonus := (npRising >= 3 ? 25.0 : npRising >= 2 ? 15.0 : 0.0) + (salesRising >= 3 ? 15.0 : 0.0)

// Cyclical: erratic NP swings, sign changes
finCyclicalBonus := npSwings >= 2 ? 30.0 : npSwings >= 1 ? 15.0 : 0.0

// Defensive: stable NP (no big swings) + low but positive
float npStability = npSwings == 0 and npFalling <= 1 ? 20.0 : 0.0
finDefensiveBonus := npStability + (salesRising <= 2 and salesRising >= 1 ? 10.0 : 0.0)

// Turnaround: NP recovering from losses
finTurnaroundBonus := npRecovery ? 35.0 : 0.0

// Blend: Chart 60% + Financial 40%
cyclicalScore  := chartCyclical  * 0.6 + math.min(finCyclicalBonus  * 1.33, 40)
growthScore    := chartGrowth    * 0.6 + math.min(finGrowthBonus    * 1.0, 40)
defensiveScore := chartDefensive * 0.6 + math.min(finDefensiveBonus * 1.33, 40)
turnaroundScore := chartTurnaround * 0.6 + math.min(finTurnaroundBonus * 1.14, 40)

maxBehav := math.max(cyclicalScore, math.max(growthScore, math.max(defensiveScore, turnaroundScore)))
behavType := maxBehav == growthScore ? "GROWTH" : maxBehav == cyclicalScore ? "CYCLICAL" : maxBehav == turnaroundScore ? "TURNAROUND" : "DEFENSIVE"
behavClr := maxBehav == growthScore ? color.new(#00E676, 0) : maxBehav == cyclicalScore ? color.new(#2196F3, 0) : maxBehav == turnaroundScore ? color.new(#AA00FF, 0) : color.new(#9E9E9E, 0)

//====================================================
// TABLE UI (v2 — enhanced for weekly investors)
//====================================================
var table t = table.new(f_pos(summaryPos), 2, 16, border_width=1)

if barstate.islast

    // Row 0: Header
    table.cell(t, 0, 0, "ISME v2", text_color=color.white, bgcolor=color.new(#1a1a2e, 0), text_size=fontSize)
    table.cell(t, 1, 0, "", bgcolor=color.new(#1a1a2e, 0))

    // Row 1: POSITION STATE (most important for weekly investors)
    table.cell(t, 0, 1, "Position", text_size=fontSize)
    table.cell(t, 1, 1, posEmoji + " " + posState, bgcolor=posClr, text_color=color.white, text_size=fontSize)

    // Row 2: Stage
    table.cell(t, 0, 2, "Stage", text_size=fontSize)
    table.cell(t, 1, 2, stageText, bgcolor=stageColor, text_color=color.white, text_size=fontSize)

    // Row 3: Score
    string scoreLabel = wScore >= 80 ? "BREAKOUT" : wScore >= 60 ? "STRONG" : wScore >= 40 ? "WATCH" : "WEAK"
    color scoreClr = wScore >= 80 ? color.new(#00E676, 0) : wScore >= 60 ? color.new(#FFD740, 0) : wScore >= 40 ? color.new(#FF9100, 0) : color.new(#FF5252, 50)
    table.cell(t, 0, 3, "Score", text_size=fontSize)
    table.cell(t, 1, 3, str.tostring(wScore, "#") + " " + scoreLabel, text_color=color.white, bgcolor=scoreClr, text_size=fontSize)

    // Row 4: Regime
    table.cell(t, 0, 4, "Regime", text_size=fontSize)
    table.cell(t, 1, 4, trendOk ? "✅ TREND" : "❌ CHOP", text_size=fontSize,
         bgcolor = trendOk ? color.new(color.green, 60) : color.new(color.red, 60))

    // Row 5: Monthly Confirmation
    color mClr = not showMTF ? color.new(color.gray, 60) : monthlyAligned ? color.new(color.green, 60) : color.new(color.orange, 40)
    table.cell(t, 0, 5, "Monthly", text_size=fontSize)
    table.cell(t, 1, 5, monthlyLabel, text_size=fontSize, bgcolor=mClr, text_color=color.white)

    // Row 6: Behavior Type
    table.cell(t, 0, 6, "Type", text_size=fontSize)
    table.cell(t, 1, 6, behavType + " " + str.tostring(maxBehav, "#") + "%", text_color=color.white, bgcolor=behavClr, text_size=fontSize)

    // Row 7: RS Percentile Rank (replaces raw RS value)
    color rsRankClr = na(rsRank) ? color.new(color.gray, 60) : rsRank >= 80 ? color.new(#00E676, 40) : rsRank >= 50 ? color.new(color.green, 70) : rsRank >= 30 ? color.new(color.orange, 60) : color.new(color.red, 60)
    string rsRankTxt = na(rsRank) ? "N/A" : str.tostring(rsRank, "#") + "%"
    string rsRankLabel = na(rsRank) ? "" : rsRank >= 80 ? " ELITE" : rsRank >= 50 ? " STRONG" : rsRank >= 30 ? " AVG" : " WEAK"
    table.cell(t, 0, 7, "RS Rank", text_size=fontSize)
    table.cell(t, 1, 7, rsRankTxt + rsRankLabel, text_size=fontSize, bgcolor=rsRankClr, text_color=color.white)

    // Row 8: ADX
    table.cell(t, 0, 8, "ADX", text_size=fontSize)
    table.cell(t, 1, 8, str.tostring(adx, "#.##"), text_size=fontSize,
         bgcolor = adx > thresholdADX ? color.new(color.green, 80) : color.new(color.red, 80))

    // Row 9: RSI
    table.cell(t, 0, 9, "RSI", text_size=fontSize)
    table.cell(t, 1, 9, str.tostring(rsi, "#.##"), text_size=fontSize,
         bgcolor = rsi > 55 ? color.new(color.green, 80) :
                   rsi < 45 ? color.new(color.red, 80) :
                   color.new(color.gray, 80))

    // Row 10: Risk/Reward (entry risk % + current R-multiple)
    string rrText = posState == "NONE" ? "—" : na(riskPct) ? "N/A" : "Risk " + str.tostring(riskPct, "#.#") + "%" + (not na(currentR) ? " | " + str.tostring(currentR, "#.#") + "R" : "")
    color rrClr = posState == "NONE" ? color.new(color.gray, 80) : not na(currentR) and currentR >= 2 ? color.new(#00E676, 40) : not na(currentR) and currentR >= 1 ? color.new(color.green, 60) : not na(currentR) and currentR >= 0 ? color.new(color.gray, 70) : color.new(color.red, 60)
    table.cell(t, 0, 10, "Risk/R", text_size=fontSize)
    table.cell(t, 1, 10, rrText, text_size=fontSize, bgcolor=rrClr, text_color=color.white)

    // Row 11: Sales QoQ
    table.cell(t, 0, 11, "Sales QoQ", text_size=fontSize)
    table.cell(t, 1, 11,
         na(salesGrowth) ? "N/A" : str.tostring(salesGrowth, "#.##") + "%", text_size=fontSize,
         bgcolor = not na(salesGrowth) and salesGrowth > 0 ?
              color.new(color.green, 80) : color.new(color.red, 80))

    // Row 12: Profit QoQ
    table.cell(t, 0, 12, "Profit QoQ", text_size=fontSize)
    table.cell(t, 1, 12,
         na(profitGrowth) ? "N/A" : str.tostring(profitGrowth, "#.##") + "%", text_size=fontSize,
         bgcolor = not na(profitGrowth) and profitGrowth > 0 ?
              color.new(color.green, 80) : color.new(color.red, 80))

    // Row 13: Market Cap
    table.cell(t, 0, 13, "Mkt Cap", text_size=fontSize)
    table.cell(t, 1, 13,
         na(marketCap) ? "N/A" : str.tostring(marketCap / CRORE, "#.##") + " Cr", text_size=fontSize)

    // Row 14: 52W High
    table.cell(t, 0, 14, "52W High", text_size=fontSize)
    table.cell(t, 1, 14,
         close >= high52 ? "✅ YES" : "NO", text_size=fontSize,
         bgcolor = close >= high52 ? color.new(color.green, 80) : color.new(color.gray, 80))

    // Row 15: Earnings + VCP status
    string statusText = ""
    color statusClr = color.new(color.gray, 80)
    if earningsSoon
        statusText := "⚠ EARNINGS SOON"
        statusClr := color.new(color.orange, 40)
    if vcpSetup
        statusText := statusText != "" ? statusText + " | VCP" : "🔷 VCP SETUP"
        statusClr := earningsSoon ? color.new(color.orange, 40) : color.new(#2196F3, 60)
    if statusText == ""
        statusText := "—"
    table.cell(t, 0, 15, "Alerts", text_size=fontSize)
    table.cell(t, 1, 15, statusText, text_size=fontSize, bgcolor=statusClr, text_color=color.white)

//====================================================
// FUNDAMENTALS TABLE (bottom-right, matching screener layout)
//====================================================
var table ft = table.new(f_pos(fundPos), 8, 9, border_width=0)

if barstate.islast
    color hdrBg  = color.new(#1a1a2e, 0)
    color rowBg1 = color.new(#16213e, 0)
    color rowBg2 = color.new(#0f3460, 0)
    color txtW   = color.white
    color txtG   = color.gray

    // Market cap classification (Indian market convention)
    float mcCr = na(marketCap) ? na : marketCap / CRORE
    string capType = na(mcCr) ? "" : mcCr >= 20000 ? " · Large Cap" : mcCr >= 5000 ? " · Mid Cap" : mcCr >= 1000 ? " · Small Cap" : " · Micro Cap"
    color capClr   = na(mcCr) ? color.yellow : mcCr >= 20000 ? color.new(#00E676, 0) : mcCr >= 5000 ? color.new(#FFD740, 0) : mcCr >= 1000 ? color.new(#FF9100, 0) : color.new(#FF5252, 0)

    // --- Row 0: Market Cap + Classification (full-width title bar) ---
    string mcStr = na(marketCap) ? "N/A" : str.tostring(marketCap / CRORE, "#,###") + " Cr"
    table.cell(ft, 0, 0, "Mkt Cap: " + mcStr + capType, text_color=capClr, bgcolor=hdrBg, text_size=fontSize, text_halign=text.align_center)
    for c = 1 to 7
        table.cell(ft, c, 0, "", bgcolor=hdrBg)
    table.merge_cells(ft, 0, 0, 7, 0)

    // --- Row 1: Sector (cols 0–3) | Industry (cols 4–7) ---
    table.cell(ft, 0, 1, syminfo.sector, text_color=color.new(color.aqua, 0), bgcolor=hdrBg, text_size=fontSize, text_halign=text.align_center)
    table.cell(ft, 1, 1, "", bgcolor=hdrBg)
    table.cell(ft, 2, 1, "", bgcolor=hdrBg)
    table.cell(ft, 3, 1, "", bgcolor=hdrBg)
    table.cell(ft, 4, 1, syminfo.industry, text_color=color.new(color.aqua, 0), bgcolor=hdrBg, text_size=fontSize, text_halign=text.align_center)
    table.cell(ft, 5, 1, "", bgcolor=hdrBg)
    table.cell(ft, 6, 1, "", bgcolor=hdrBg)
    table.cell(ft, 7, 1, "", bgcolor=hdrBg)
    table.merge_cells(ft, 0, 1, 3, 1)
    table.merge_cells(ft, 4, 1, 7, 1)

    // --- Row 2: Column Headers (tight, no border gaps) ---
    string[] hdrs = array.from("FQ", "NP", "YoY", "QoQ", "Sales", "YoY", "QoQ", "OPM")
    for c = 0 to 7
        table.cell(ft, c, 2, array.get(hdrs, c), text_color=txtW, bgcolor=color.new(#533483, 0), text_size=fontSize)

    // --- Rows 3–7: Quarter data ---
    for row = 0 to 4
        int r = row + 3
        color rBg = row % 2 == 0 ? rowBg1 : rowBg2

        string lbl = array.get(q_lbl, row)
        float np   = array.get(q_np, row)
        float sal  = array.get(q_sales, row)
        float oi   = array.get(q_oi, row)

        // YoY = vs 4 quarters back (array is 9 deep, so row+4 always valid)
        float np4  = row + 4 < 9 ? array.get(q_np, row + 4) : na
        float sal4 = row + 4 < 9 ? array.get(q_sales, row + 4) : na
        // QoQ = vs previous quarter
        float np1  = row + 1 < 9 ? array.get(q_np, row + 1) : na
        float sal1 = row + 1 < 9 ? array.get(q_sales, row + 1) : na

        float npYoY  = not na(np) and not na(np4) and np4 != 0 ? ((np - np4) / math.abs(np4)) * 100 : na
        float npQoQ  = not na(np) and not na(np1) and np1 != 0 ? ((np - np1) / math.abs(np1)) * 100 : na
        float salYoY = not na(sal) and not na(sal4) and sal4 != 0 ? ((sal - sal4) / math.abs(sal4)) * 100 : na
        float salQoQ = not na(sal) and not na(sal1) and sal1 != 0 ? ((sal - sal1) / math.abs(sal1)) * 100 : na
        float opm    = not na(oi) and not na(sal) and sal != 0 ? (oi / sal) * 100 : na

        // Growth % colors: vivid green/red backgrounds for instant readability
        color npYoYbg  = na(npYoY)  ? rBg : npYoY  > 0 ? color.new(#00C853, 40) : color.new(#FF1744, 40)
        color npQoQbg  = na(npQoQ)  ? rBg : npQoQ  > 0 ? color.new(#00C853, 40) : color.new(#FF1744, 40)
        color salYoYbg = na(salYoY) ? rBg : salYoY > 0 ? color.new(#00C853, 40) : color.new(#FF1744, 40)
        color salQoQbg = na(salQoQ) ? rBg : salQoQ > 0 ? color.new(#00C853, 40) : color.new(#FF1744, 40)

        // FQ label
        table.cell(ft, 0, r, lbl != "" ? lbl : "--", text_color=txtW, bgcolor=rBg, text_size=fontSize)
        // Net Profit (in Cr)
        table.cell(ft, 1, r, na(np) ? "--" : str.tostring(np / CRORE, "#"), text_color=txtW, bgcolor=rBg, text_size=fontSize)
        // NP YoY % (colored bg)
        table.cell(ft, 2, r, na(npYoY) ? "--" : str.tostring(npYoY, "#") + "%", text_color=txtW, bgcolor=npYoYbg, text_size=fontSize)
        // NP QoQ % (colored bg)
        table.cell(ft, 3, r, na(npQoQ) ? "--" : str.tostring(npQoQ, "#") + "%", text_color=txtW, bgcolor=npQoQbg, text_size=fontSize)
        // Sales (in Cr)
        table.cell(ft, 4, r, na(sal) ? "--" : str.tostring(sal / CRORE, "#"), text_color=txtW, bgcolor=rBg, text_size=fontSize)
        // Sales YoY % (colored bg)
        table.cell(ft, 5, r, na(salYoY) ? "--" : str.tostring(salYoY, "#") + "%", text_color=txtW, bgcolor=salYoYbg, text_size=fontSize)
        // Sales QoQ % (colored bg)
        table.cell(ft, 6, r, na(salQoQ) ? "--" : str.tostring(salQoQ, "#") + "%", text_color=txtW, bgcolor=salQoQbg, text_size=fontSize)
        // OPM %
        table.cell(ft, 7, r, na(opm) ? "--" : str.tostring(opm, "#.#") + "%", text_color=txtW, bgcolor=rBg, text_size=fontSize)

//====================================================
// INSIDER / INSTITUTIONAL ACTIVITY DETECTOR
//====================================================
// Detects unusual volume + price action patterns that signal smart money
volRatio     = volume / volMA
priceRange   = high - low
closePos     = priceRange > 0 ? (close - low) / priceRange : 0.5

// Accumulation: high volume + close in upper 60% of range
accumulation = volRatio > 2.0 and closePos > 0.6 and close > close[1]
// Distribution: high volume + close in lower 40% of range
distribution = volRatio > 2.0 and closePos < 0.4 and close < close[1]
// Stealth accumulation: ATR-normalized price movement
stealth      = ta.sma(volume, 5) > volMA * 1.5 and math.abs(close - close[5]) / atr < 0.5 and close > ema50

// Trigger versions (fire once)
accum_trigger = accumulation and not accumulation[1]
dist_trigger  = distribution and not distribution[1]
stealth_trigger = stealth and not stealth[1]

// Gate insider buy signals by regime (DIST always fires)
plotshape(
     showInsider and accum_trigger and trendOk,
     title="Accumulation",
     text="ACC",
     style=shape.labelup,
     location=location.belowbar,
     color=color.new(#00E676, 0),
     textcolor=color.black,
     size=size.small
)

plotshape(
     showInsider and dist_trigger,
     title="Distribution",
     text="DIST",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.new(#FF1744, 0),
     textcolor=color.white,
     size=size.small
)

plotshape(
     showInsider and stealth_trigger and trendOk,
     title="Stealth Accumulation",
     text="🕵",
     style=shape.labelup,
     location=location.belowbar,
     color=color.new(#7C4DFF, 0),
     textcolor=color.white,
     size=size.small
)

//====================================================
// SIGNAL LEGEND TABLE (toggle with checkbox — v2 expanded)
//====================================================
var table legend = na

if showLegend and barstate.islast
    legend := table.new(f_pos(legendPos), 2, 28, border_width=0)
    color lBg  = color.new(#1a1a2e, 10)
    color lBg2 = color.new(#0f3460, 10)
    color lHdr = color.new(#533483, 0)
    color lSec = color.new(#1B5E20, 0)
    color lNew = color.new(#0D47A1, 0)

    table.cell(legend, 0, 0, "Signal", text_color=color.white, bgcolor=lHdr, text_size=legendSize)
    table.cell(legend, 1, 0, "How to Read", text_color=color.white, bgcolor=lHdr, text_size=legendSize)

    // --- Buy Signals ---
    table.cell(legend, 0, 1, "🟢 A", text_color=color.green, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 1, "Trend breakout — EMA aligned + RSI > 55 + ADX strong (40pts)", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 2, "🟢 B", text_color=color.lime, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 2, "Donchian breakout — Close crosses 20-day high + volume surge (30pts)", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 3, "🟢 C", text_color=color.teal, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 3, "52W breakout — Price at yearly high + RS outperforming (30pts)", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 4, "🔵 STRONG", text_color=color.blue, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 4, "Score ≥70 — Suppresses A/B/C, highest conviction signal", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    // --- Sell Signals ---
    table.cell(legend, 0, 5, "🔴 X", text_color=color.red, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 5, "Momentum loss — Below EMA20 + RSI < 45 (suppressed if Z fires)", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 6, "🔴 Y", text_color=color.maroon, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 6, "Trend weakness — Below EMA50 + RS < RS EMA (suppressed if Z)", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 7, "🟠 Z", text_color=color.orange, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 7, "Trend breakdown — Below EMA200 + strong ADX (highest priority)", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    // --- Chart Markers ---
    table.cell(legend, 0, 8, "◆", text_color=color.orange, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 8, "Donchian — Close crosses above 20-day channel high", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 9, "🔥 52W", text_color=color.yellow, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 9, "52-week high — Major breakout level", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 10, "▲", text_color=color.purple, bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 10, "RS high — Relative Strength at 100-bar peak", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    // --- Insider Activity ---
    table.cell(legend, 0, 11, "ACC", text_color=color.new(#00E676, 0), bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 11, "Accumulation — 2x vol + close in upper 60% (regime gated)", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 12, "DIST", text_color=color.new(#FF1744, 0), bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 12, "Distribution — 2x vol + close in lower 40% (always fires)", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 13, "🕵", text_color=color.new(#7C4DFF, 0), bgcolor=lBg, text_size=legendSize)
    table.cell(legend, 1, 13, "Stealth — Vol rising 1.5x, price flat (ATR-norm, regime gated)", text_color=color.white, bgcolor=lBg, text_size=legendSize, text_halign=text.align_left)

    // --- v2 NEW: Position States ---
    table.cell(legend, 0, 14, "v2 NEW", text_color=color.white, bgcolor=lNew, text_size=legendSize)
    table.cell(legend, 1, 14, "Position State Machine", text_color=color.white, bgcolor=lNew, text_size=legendSize)

    table.cell(legend, 0, 15, "🟢 ENTRY", text_color=color.new(#00E676, 0), bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 15, "Buy signal fired — initiate new position", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 16, "🔵 HOLD", text_color=color.new(#2196F3, 0), bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 16, "In Stage 2, above stop — maintain position", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 17, "🟢 ADD", text_color=color.new(#00E676, 0), bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 17, "New buy signal while holding — consider adding to position", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 18, "🟡 TIGHTEN", text_color=color.new(#FFD740, 0), bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 18, "Early warning — RS weakening or below EMA20, tighten stop", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 19, "🟠 REDUCE", text_color=color.new(#FF9100, 0), bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 19, "Sell X fired — reduce position size, protect profits", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 20, "🔴 EXIT", text_color=color.new(#FF1744, 0), bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 20, "Sell Y/Z fired — exit position completely", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    // --- v2 NEW: Other features ---
    table.cell(legend, 0, 21, "🔷 VCP", text_color=color.new(#2196F3, 0), bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 21, "Volatility Contraction — ATR contracting + range tightening in Stage 2", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 22, "⚠ EARN", text_color=color.orange, bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 22, "Earnings imminent — approaching next quarter end (manage risk)", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    // --- System Settings ---
    table.cell(legend, 0, 23, "SYSTEM", text_color=color.white, bgcolor=lSec, text_size=legendSize)
    table.cell(legend, 1, 23, "Detection Logic", text_color=color.white, bgcolor=lSec, text_size=legendSize)

    table.cell(legend, 0, 24, "Regime", text_color=color.aqua, bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 24, "ADX > 18 + EMA50 > EMA200 → gates all buy signals", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 25, "Score", text_color=color.aqua, bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 25, "A=40 + B=30 + C=30 → 80+ Break, 60+ Strong, 40+ Watch", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 26, "Monthly", text_color=color.aqua, bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 26, "Monthly EMA10 > EMA40 + Stage 2 → confirms weekly signals", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

    table.cell(legend, 0, 27, "RS Rank", text_color=color.aqua, bgcolor=lBg2, text_size=legendSize)
    table.cell(legend, 1, 27, "Percentile rank of RS over 252 bars — 80+ Elite, 50+ Strong", text_color=color.white, bgcolor=lBg2, text_size=legendSize, text_halign=text.align_left)

//====================================================
// ALERTS (trigger-based, fire once per transition)
//====================================================
alertcondition(
     strongBuy and trendOk,
     title="STRONG BUY (High Confidence)",
     message="🚀 STRONG BUY — {{ticker}} score 70+ in trending regime"
)

alertcondition(
     showA,
     title="BUY A",
     message="BUY A Trigger — {{ticker}} crossed into trend breakout zone"
)

alertcondition(
     showB,
     title="BUY B",
     message="BUY B Trigger — {{ticker}} Donchian breakout with volume"
)

alertcondition(
     showC,
     title="BUY C",
     message="BUY C Trigger — {{ticker}} 52W high breakout with RS strength"
)

alertcondition(
     sellX,
     title="SELL X",
     message="SELL X — {{ticker}} below EMA20 with weak RSI"
)

alertcondition(
     sellY,
     title="SELL Y",
     message="SELL Y — {{ticker}} below EMA50 with RS weakness"
)

alertcondition(
     sellZ,
     title="SELL Z",
     message="SELL Z — {{ticker}} below EMA200 with strong ADX decline"
)

// v2 NEW: Position State alerts
alertcondition(
     posState == "ENTRY" and posState[1] == "NONE",
     title="POSITION: ENTRY",
     message="🟢 ENTRY — {{ticker}} new position signal"
)

alertcondition(
     posState == "ADD" and posState[1] != "ADD",
     title="POSITION: ADD",
     message="🟢 ADD — {{ticker}} add to position signal"
)

alertcondition(
     posState == "TIGHTEN" and posState[1] != "TIGHTEN",
     title="POSITION: TIGHTEN",
     message="🟡 TIGHTEN — {{ticker}} early warning, tighten stops"
)

alertcondition(
     posState == "REDUCE" and posState[1] != "REDUCE",
     title="POSITION: REDUCE",
     message="🟠 REDUCE — {{ticker}} reduce position size"
)

alertcondition(
     posState == "EXIT" and posState[1] != "EXIT",
     title="POSITION: EXIT",
     message="🔴 EXIT — {{ticker}} exit position completely"
)

// v2 NEW: VCP alert
alertcondition(
     showVCP and vcpTrigger,
     title="VCP SETUP",
     message="🔷 VCP — {{ticker}} Volatility Contraction Pattern detected in Stage 2"
)

// v2 NEW: Earnings proximity alert
alertcondition(
     earningsSoon and not earningsSoon[1],
     title="EARNINGS WARNING",
     message="⚠ EARNINGS — {{ticker}} quarterly results likely imminent, manage risk"
)
