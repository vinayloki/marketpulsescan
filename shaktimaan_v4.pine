//@version=6
// ══════════════════════════════════════════════════════════════════════
// ██╗███████╗███╗   ███╗███████╗    ██╗   ██╗██╗  ██╗
// ██║██╔════╝████╗ ████║██╔════╝    ██║   ██║██║  ██║
// ██║███████╗██╔████╔██║█████╗      ██║   ██║███████║
// ██║╚════██║██║╚██╔╝██║██╔══╝      ╚██╗ ██╔╝╚════██║
// ██║███████║██║ ╚═╝ ██║███████╗     ╚████╔╝      ██║
// ╚═╝╚══════╝╚═╝     ╚═╝╚══════╝      ╚═══╝       ╚═╝
//
// Institutional Stage Momentum Engine (ISME) v4.1
// Enhanced summary table with Minervini trend template scoring,
// Mansfield RS, sector RS, position sizing, pyramid tracking,
// and comprehensive investment decision scoring.
//
// v4.1 CHANGELOG:
// • Fixed Stage Analysis classification gap that sent recovering
//   stocks (V-shaped recoveries like HFCL) to Stage 4 incorrectly.
// • Replaced strict ta.rising(ema200, 20) with slope-based
//   ema200 > ema200[20] (net upward, not monotonic).
// • Added STAGE 2E (Early) for transitional advancing stocks.
// • VCP now also triggers in Stage 2E.
//
// ── HOW TO USE ──────────────────────────────────────────────────────
// • Apply to any NSE/BSE equity on Daily or Weekly timeframe.
// • The BEHAVIOR row tells you the investment decision:
//   ● BUY  ◐ HOLD  ⊙ AVOID (with composite score /100)
// • The POSITION row tracks your state machine:
//   🟢 ENTRY/ADD  🔵 HOLD  🟡 TIGHTEN  🟠 REDUCE  🔴 EXIT
// • Change "RS Sector Index" to match your stock's sector
//   (e.g., NSE:NIFTY_BANK for banking stocks)
//
// ── DISCLAIMER ──────────────────────────────────────────────────────
// Educational/informational only. Not financial advice.
// ══════════════════════════════════════════════════════════════════════

indicator("Institutional Stage Momentum Engine (ISME) v4.1", shorttitle="ISME v4.1", overlay=true, max_labels_count=500, max_bars_back=500)

//====================================================
// INPUTS
//====================================================
lengthADX     = input.int(14, "Length ADX", group="Trend & Momentum", tooltip="Period for Average Directional Index calculation.")
thresholdADX  = input.int(14, "Threshold ADX", group="Trend & Momentum", tooltip="Minimum ADX value for trend confirmation.")
lengthRSI     = input.int(14, "Length RSI", group="Trend & Momentum", tooltip="Period for Relative Strength Index.")

sarStart      = input.float(0.02, "SAR Start", group="Parabolic SAR")
sarInc        = input.float(0.02, "SAR Increment", group="Parabolic SAR")
sarMax        = input.float(0.2, "SAR Max Value", group="Parabolic SAR")

rsSymbol       = input.symbol("NSE:NIFTY", "RS Index", group="Relative Strength", tooltip="Benchmark index for RS calculation.")
rsSectorSymbol = input.symbol("NSE:NIFTY", "RS Sector Index", group="Relative Strength", tooltip="Sector benchmark for RS vs Sector. Change to your stock sector index — NSE:NIFTY_BANK, NSE:NIFTY_IT, NSE:NIFTY_METAL, NSE:NIFTY_PHARMA etc.")
rsMAPeriod     = input.int(10, "RS MA Period", group="Relative Strength", tooltip="EMA period for RS ratio line.")

riskAmountInput = input.float(10000, "Risk Per Trade (₹)", minval=1000, step=1000, group="Position Sizing", tooltip="Maximum ₹ risk per trade. Used to calculate position size from entry-to-stop distance.")
maxPyramidInput = input.int(2, "Max Pyramid Adds", minval=0, maxval=5, group="Position Sizing", tooltip="Maximum pyramid (add) opportunities per position.")

showMTF       = input.bool(true, "Monthly Confirmation", group="Multi-Timeframe", tooltip="Monthly trend validation for higher-conviction entries.")
showSAR       = input.bool(true, "Show Parabolic SAR", group="Display")
showInsider   = input.bool(true, "Show Insider Activity", group="Display")
showVCP       = input.bool(true, "Show VCP Setups", group="Display")
showRR        = input.bool(true, "Show Risk/Reward", group="Display")
showLegend    = input.bool(false, "Show Signal Legend", group="Display")
tableFontSize = input.string("Normal", "Table Font Size", options=["Tiny", "Small", "Normal", "Large"], group="Display")

summaryPos    = input.string("Top Right", "Summary Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Table Positions")
fundPos       = input.string("Bottom Right", "Fundamentals Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Table Positions")
legendPos     = input.string("Bottom Left", "Legend Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Table Positions")

fontSize = tableFontSize == "Tiny" ? size.tiny : tableFontSize == "Small" ? size.small : tableFontSize == "Large" ? size.large : size.normal
legendSize = tableFontSize == "Tiny" ? size.tiny : tableFontSize == "Small" ? size.tiny : tableFontSize == "Large" ? size.normal : size.small

f_pos(string p) =>
    p == "Top Left" ? position.top_left : p == "Top Right" ? position.top_right : p == "Bottom Left" ? position.bottom_left : position.bottom_right

//====================================================
// CORE CALCULATIONS
//====================================================
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema150 = ta.ema(close, 150)
ema200 = ta.ema(close, 200)

rsi = ta.rsi(close, lengthRSI)
[diplus, diminus, adx] = ta.dmi(lengthADX, lengthADX)
atr = ta.atr(14)
psar = ta.sar(sarStart, sarInc, sarMax)

donHigh = ta.highest(high, 20)
donLow  = ta.lowest(low, 20)

// 52 Week High/Low (NO REPAINT — uses [1] to exclude current bar)
high52 = ta.highest(high[1], 252)
low52  = ta.lowest(low[1], 252)

volMA = ta.sma(volume, 20)

// Cached swing lows for risk-reward (global scope for consistency)
lowest10 = ta.lowest(low, 10)
lowest5  = ta.lowest(low, 5)

// ATR % (volatility as percentage of price)
float atrPct = atr / close * 100

// Volume surge ratio
float volSurgeRatio = volume / volMA

//====================================================
// RELATIVE STRENGTH (enhanced)
//====================================================
indexClose = request.security(rsSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off)
rs = not na(indexClose) and indexClose > 0 ? close / indexClose : na
rsEMA = ta.ema(rs, rsMAPeriod)

// RS Percentile Rank (0-100)
rsRank = ta.percentrank(rs, 252)

// RS vs Sector
sectorClose = request.security(rsSectorSymbol, timeframe.period, close, lookahead=barmerge.lookahead_off)
rsSec = not na(sectorClose) and sectorClose > 0 ? close / sectorClose : na
rsSecEMA = ta.ema(rsSec, rsMAPeriod)

// Mansfield RS = (RS / SMA(RS, 52w) - 1) × 100
int mansfieldLen = timeframe.isweekly ? 52 : 252
rsSMA = ta.sma(rs, mansfieldLen)
mansfield = not na(rs) and not na(rsSMA) and rsSMA > 0 ? ((rs / rsSMA) - 1) * 100 : na

// Weekly RS direction (compare RS over ~1 week of bars)
int rsLookback = timeframe.isweekly ? 1 : 5
weeklyRSup = not na(rs) and bar_index >= rsLookback and rs > rs[rsLookback]

//====================================================
// MONTHLY TIMEFRAME CONFIRMATION
//====================================================
[mTrendOk, mStage2ok] = request.security(syminfo.tickerid, "M",
    [ta.ema(close, 10) > ta.ema(close, 40),
     close > ta.ema(close, 30) and ta.ema(close, 30) > ta.ema(close, 40)],
    lookahead=barmerge.lookahead_off)

monthlyAligned = not showMTF or (mTrendOk and mStage2ok)

//====================================================
// BACKGROUND COLOR (RS)
//====================================================
bgBull = rs > rsEMA
bgcolor(bgBull ? color.new(#00E676, 82) : color.new(#FF1744, 82))

//====================================================
// MA CROSSOVER BAND
//====================================================
bullBand = ema20 > ema50
p_ema20 = plot(ema20, color=color.new(color.aqua, 60), linewidth=1, title="EMA 20")
p_ema50 = plot(ema50, color=color.new(color.orange, 60), linewidth=1, title="EMA 50")
fill(p_ema20, p_ema50,
     color = bullBand ? color.new(color.lime, 85) : color.new(color.red, 85),
     title = "MA Band Fill")

//====================================================
// MINERVINI TREND TEMPLATE
//====================================================
trendTemplate = (
    close > ema50 and
    close > ema150 and
    close > ema200 and
    ema50 > ema150 and
    ema150 > ema200
)

//====================================================
// TREND TEMPLATE SCORE (0/8 — Minervini checklist)
//====================================================
int ttScore = 0
if close > ema50
    ttScore := ttScore + 1
if close > ema150
    ttScore := ttScore + 1
if close > ema200
    ttScore := ttScore + 1
if ema50 > ema150
    ttScore := ttScore + 1
if ema150 > ema200
    ttScore := ttScore + 1
if not na(low52) and low52 > 0 and close > low52 * 1.30
    ttScore := ttScore + 1
if not na(high52) and close >= high52 * 0.75
    ttScore := ttScore + 1
if not na(rs) and not na(rsEMA) and rs > rsEMA
    ttScore := ttScore + 1

//====================================================
// STOCK BEHAVIOR TYPE CLASSIFIER (chart-based component)
//====================================================
float bVol      = ta.stdev(close, 100) / close * 100
float bMaxDD    = (ta.highest(close, 252) - ta.lowest(close, 252)) / ta.highest(close, 252) * 100
float trendPersist = ta.sma(close > ema50 ? 1.0 : 0.0, 100) * 100
float rsBonus      = not na(rs) and not na(rsEMA) and rs > rsEMA ? 20.0 : 0.0
float growthRate   = (close - close[100]) / close[100] * 100
float slopeShort   = ta.linreg(close, 20, 0)
float slopeLong    = ta.linreg(close, 100, 0)
float slopeChange  = slopeShort - slopeLong
float baseBreak    = close > ta.highest(close, 60)[1] ? 30.0 : 0.0

float chartCyclical  = math.min(bVol * 3 + bMaxDD, 100)
float chartGrowth    = math.min(trendPersist + rsBonus, 100)
float chartDefensive = math.min(math.max(100 - bVol * 5 - math.abs(growthRate), 0), 100)
float chartTurnaround = math.min(math.max(slopeChange / atr * 10 + baseBreak, 0), 100)

var float cyclicalScore  = 0.0
var float growthScore    = 0.0
var float defensiveScore = 0.0
var float turnaroundScore = 0.0
var string behavType = "--"
var color behavClr = color.gray
var float maxBehav = 0.0

//====================================================
// MARKET REGIME FILTER
//====================================================
trendOk = adx > 18 and ema50 > ema200

var int lastBuyBar = 0
cooldownOk = bar_index - lastBuyBar >= 5
buyAllowed = trendOk and cooldownOk

//====================================================
// BUY CONDITIONS
//====================================================
buyA_state = (
    close > ema20 and
    ema20 > ema50 and
    rsi > 55 and
    adx > thresholdADX and
    trendTemplate
)
buyA_raw = buyA_state and not buyA_state[1]
buyA = buyA_raw and buyAllowed

buyB_raw = ta.crossover(close, ta.highest(high, 20)[1]) and volume > volMA
buyB = buyB_raw and buyAllowed

buyC_state = (
    close >= high52 and
    not na(rs) and rs > rsEMA
)
buyC_raw = buyC_state and not buyC_state[1]
buyC = buyC_raw and buyAllowed

//====================================================
// WEIGHTED INSTITUTIONAL SCORING (0-100)
//====================================================
wScore = (buyA_state ? 40.0 : 0.0) + (buyB_raw ? 30.0 : 0.0) + (buyC_state ? 30.0 : 0.0)

if showMTF
    float monthlyBonus = 0.0
    if monthlyAligned
        monthlyBonus += 10
    if mTrendOk
        monthlyBonus += 5
    if mStage2ok
        monthlyBonus += 5
    wScore += monthlyBonus
    if not monthlyAligned
        wScore -= 10

strongBuy_state = wScore >= 70
strongBuy_raw = strongBuy_state and not strongBuy_state[1]
strongBuy = strongBuy_raw and buyAllowed

if strongBuy
    lastBuyBar := bar_index

showA = buyA and not strongBuy
showB = buyB and not strongBuy
showC = buyC and not strongBuy

//====================================================
// SELL CONDITIONS
//====================================================
sellX_state = close < ema20 and rsi < 45
sellX_raw = sellX_state and not sellX_state[1]

sellY_state = close < ema50 and not na(rs) and rs < rsEMA
sellY_raw = sellY_state and not sellY_state[1]

sellZ_state = close < ema200 and adx > thresholdADX
sellZ = sellZ_state and not sellZ_state[1]

sellX = sellX_raw and not sellZ
sellY = sellY_raw and not sellZ

//====================================================
// STAGE ANALYSIS (v4.1 — slope-based, no classification gaps)
//====================================================
// v4.1 FIX: Replaced ta.rising(ema200, 20) with ema200 > ema200[20].
// ta.rising() requires STRICT monotonic increase for ALL 20 bars —
// even one flat bar kills it. This caused V-shaped recoveries (e.g.
// HFCL going ₹60→₹162) to show Stage 4 despite 8/8 trend template.
// The new slope-based check only requires NET upward movement.

// Stage 2: Confirmed advance — EMA200 has net upward slope over 20 bars
stage2 = (
    close > ema150 and
    ema150 > ema200 and
    ema200 > ema200[20]
)

// Stage 2 Early: Transitional — price & EMAs aligned but EMA200 only
// recently turned up (net up over 10 bars, not yet 20). This closes the
// gap that previously sent recovering stocks straight to Stage 4.
stage2early = (
    not stage2 and
    close > ema150 and
    ema150 > ema200 and
    ema200 > ema200[10]
)

// Stage 1: Basing — price above EMA200 but EMA200 is flat
// (neither net-rising over 10 bars nor net-falling over 10 bars)
stage1 = (
    not stage2 and not stage2early and
    close > ema200 and
    not (ema200 > ema200[10]) and
    not (ema200 < ema200[10])
)

// Stage 3: Top / Distribution — price has broken below EMA150 but
// still above EMA200 (early deterioration)
stage3 = (
    not stage2 and not stage2early and not stage1 and
    close < ema150 and
    close > ema200
)

// Stage 4: Decline — everything else
stage4 = not stage2 and not stage2early and not stage1 and not stage3

stageText =
     stage2      ? "STAGE 2" :
     stage2early ? "STAGE 2E" :
     stage1      ? "STAGE 1" :
     stage3      ? "STAGE 3" :
     "STAGE 4"

stageColor =
     stage2      ? color.green :
     stage2early ? color.new(#66BB6A, 0) :
     stage1      ? color.gray :
     stage3      ? color.orange :
     color.red

string stageEmoji =
     stage2      ? "●" :
     stage2early ? "◐" :
     stage1      ? "◐" :
     stage3      ? "●" :
     "●"

//====================================================
// VCP (VOLATILITY CONTRACTION PATTERN)
//====================================================
atrShort   = ta.atr(5)
atrRef     = ta.atr(5)[10]
vcpATR     = not na(atrRef) and atrRef > 0 and atrShort < atrRef * 0.6

rangeShort = ta.highest(high, 5) - ta.lowest(low, 5)
rangeLong  = ta.highest(high, 20) - ta.lowest(low, 20)
vcpRange   = not na(rangeLong) and rangeLong > 0 and rangeShort < rangeLong * 0.5

// v4.1: VCP now also triggers in Stage 2 Early (recovering stocks
// forming tight bases deserve VCP detection too)
vcpSetup   = vcpATR and vcpRange and (stage2 or stage2early) and close > ema50
vcpTrigger = vcpSetup and not vcpSetup[1]

//====================================================
// POSITION STATE MACHINE (with pyramid tracking)
//====================================================
var string posState = "NONE"
var int stateStartBar = 0
var int pyramidCount = 0

bool anyBuySignal = strongBuy or showA or showB or showC

if sellZ or sellY
    posState := "EXIT"
else if posState != "NONE" and sellX
    posState := "REDUCE"
else if strongBuy
    posState := posState == "NONE" ? "ENTRY" : "ADD"
else if posState == "NONE" and (showA or showB or showC)
    posState := "ENTRY"
else if (posState == "HOLD" or posState == "TIGHTEN") and (showA or showB or showC)
    posState := "ADD"
else if posState == "ENTRY" or posState == "ADD"
    if bar_index - stateStartBar >= 3
        posState := "HOLD"
else if posState == "EXIT"
    posState := "NONE"
else if posState == "REDUCE"
    if close > ema50 and trendOk
        posState := "HOLD"
    else if bar_index - stateStartBar >= 5
        posState := "EXIT"
else if posState == "HOLD"
    bool shouldTighten = false
    if close < ema20 and close > ema50
        shouldTighten := true
    if not na(rs) and not na(rsEMA) and rs < rsEMA and rs[1] >= rsEMA[1]
        shouldTighten := true
    if adx < 15 and adx[1] >= 15
        shouldTighten := true
    if shouldTighten
        posState := "TIGHTEN"
else if posState == "TIGHTEN"
    if close > ema20 and (na(rs) or rs > rsEMA)
        posState := "HOLD"

// Track state transitions
if posState != posState[1]
    stateStartBar := bar_index

// Pyramid tracking
if posState == "ADD" and posState[1] != "ADD"
    pyramidCount := math.min(pyramidCount + 1, maxPyramidInput)
if posState == "NONE" and posState[1] != "NONE"
    pyramidCount := 0

// State colors
color posClr = switch posState
    "ENTRY"   => color.new(#00E676, 0)
    "ADD"     => color.new(#00E676, 0)
    "HOLD"    => color.new(#2196F3, 0)
    "TIGHTEN" => color.new(#FFD740, 0)
    "REDUCE"  => color.new(#FF9100, 0)
    "EXIT"    => color.new(#FF1744, 0)
    => color.new(#9E9E9E, 0)

string posEmoji = switch posState
    "ENTRY"   => "🟢"
    "ADD"     => "🟢"
    "HOLD"    => "🔵"
    "TIGHTEN" => "🟡"
    "REDUCE"  => "🟠"
    "EXIT"    => "🔴"
    => "⚪"

//====================================================
// RISK-REWARD TRACKING (with sizing)
//====================================================
var float entryPrice = na
var float entryStop  = na

if posState == "ENTRY" and posState[1] != "ENTRY"
    entryPrice := close
    entryStop  := lowest10

if posState == "HOLD" or posState == "ADD" or posState == "TIGHTEN"
    float newStop = posState == "TIGHTEN" ? lowest5 : lowest10
    if not na(entryStop) and newStop > entryStop
        entryStop := newStop

if posState == "NONE"
    entryPrice := na
    entryStop  := na

float riskAmt  = not na(entryPrice) and not na(entryStop) ? entryPrice - entryStop : na
float riskPct  = not na(riskAmt) and entryPrice > 0 ? riskAmt / entryPrice * 100 : na
float target2R = not na(entryPrice) and not na(riskAmt) and riskAmt > 0 ? entryPrice + riskAmt * 2 : na
float target3R = not na(entryPrice) and not na(riskAmt) and riskAmt > 0 ? entryPrice + riskAmt * 3 : na
float currentR = not na(riskAmt) and riskAmt > 0 ? (close - entryPrice) / riskAmt : na

// Position sizing (shares based on risk amount)
float sharesSize = not na(riskAmt) and riskAmt > 0 ? math.floor(riskAmountInput / riskAmt) : na
float riskValueK = riskAmountInput / 1000

//====================================================
// STRUCTURE-BASED STOP
//====================================================
longStop = lowest10

plot(longStop, color=color.new(color.red, 30), linewidth=1, style=plot.style_stepline, title="Swing Stop")

//====================================================
// PARABOLIC SAR
//====================================================
plot(showSAR ? psar : na, style=plot.style_cross, color=close > psar ? color.green : color.red, linewidth=1, title="Parabolic SAR")

//====================================================
// RS NEW HIGH
//====================================================
rsHighPrev  = ta.highest(rs[1], 100)
rsHigh      = rs >= rsHighPrev and rs[1] < rsHighPrev[1]
plotshape(rsHigh, title="RS High", style=shape.triangleup, location=location.belowbar, color=color.purple, size=size.small)

//====================================================
// BUY SHAPES
//====================================================
plotshape(showA, title="BUY A", text="A", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(showB, title="BUY B", text="B", style=shape.labelup, location=location.belowbar, color=color.lime, textcolor=color.black, size=size.small)
plotshape(showC, title="BUY C", text="C", style=shape.labelup, location=location.belowbar, color=color.teal, textcolor=color.white, size=size.small)
plotshape(strongBuy, title="STRONG BUY", text="STRONG", style=shape.labelup, location=location.belowbar, color=color.blue, textcolor=color.white, size=size.normal)

//====================================================
// SELL SHAPES
//====================================================
plotshape(sellX, title="SELL X", text="X", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
plotshape(sellY, title="SELL Y", text="Y", style=shape.labeldown, location=location.abovebar, color=color.maroon, textcolor=color.white, size=size.small)
plotshape(sellZ, title="SELL Z", text="Z", style=shape.labeldown, location=location.abovebar, color=color.orange, textcolor=color.white, size=size.small)

//====================================================
// VCP SHAPE
//====================================================
plotshape(showVCP and vcpTrigger, title="VCP Setup", text="VCP\n🔷", style=shape.labelup, location=location.belowbar, color=color.new(#2196F3, 0), textcolor=color.white, size=size.small)

//====================================================
// DONCHIAN DOT
//====================================================
donBreak = ta.crossover(close, ta.highest(high, 20)[1])
plotshape(donBreak, title="Donchian", style=shape.diamond, location=location.abovebar, color=color.orange, size=size.small)

//====================================================
// 52W HIGH FLAG
//====================================================
newHigh52 = close >= high52 and close[1] < ta.highest(high[2], 252)
plotshape(newHigh52, title="52W High", text="52W\n🔥", style=shape.labeldown, location=location.abovebar, color=color.new(#FFD700, 0), textcolor=color.black, size=size.normal)

//====================================================
// RISK-REWARD BOX
//====================================================
var box  rrBox     = na
var line t2rLine   = na
var line t3rLine   = na
var label t2rLabel = na
var label t3rLabel = na
var label entLabel = na

if barstate.islast
    box.delete(rrBox)
    line.delete(t2rLine)
    line.delete(t3rLine)
    label.delete(t2rLabel)
    label.delete(t3rLabel)
    label.delete(entLabel)

    if showRR and posState != "NONE" and not na(entryPrice) and not na(entryStop) and entryPrice > entryStop
        int boxLeft  = bar_index - 10
        int boxRight = bar_index + 5

        rrBox := box.new(boxLeft, entryPrice, boxRight, entryStop,
            bgcolor=color.new(color.red, 88), border_color=color.new(color.red, 50), border_width=1)
        entLabel := label.new(boxRight, entryPrice, "Entry " + str.tostring(entryPrice, "#.##"),
            style=label.style_label_left, color=color.new(#2196F3, 70), textcolor=color.white, size=size.tiny)

        if not na(target2R)
            t2rLine := line.new(boxLeft, target2R, boxRight, target2R,
                color=color.new(color.green, 30), style=line.style_dashed, width=1)
            t2rLabel := label.new(boxRight, target2R, "2R " + str.tostring(target2R, "#.##"),
                style=label.style_label_left, color=color.new(color.green, 70), textcolor=color.white, size=size.tiny)

        if not na(target3R)
            t3rLine := line.new(boxLeft, target3R, boxRight, target3R,
                color=color.new(#00E676, 30), style=line.style_dashed, width=1)
            t3rLabel := label.new(boxRight, target3R, "3R " + str.tostring(target3R, "#.##"),
                style=label.style_label_left, color=color.new(#00E676, 70), textcolor=color.white, size=size.tiny)

//====================================================
// STAGE LABEL
//====================================================
var label stageLabel = na

if barstate.islast
    label.delete(stageLabel)
    stageLabel := label.new(bar_index, high + atr * 3, stageText,
         style=label.style_label_down, color=stageColor, textcolor=color.white, size=size.normal)

//====================================================
// FINANCIAL DATA
//====================================================
string cleanTicker = ticker.standard(syminfo.tickerid)

revenue = request.financial(cleanTicker, "TOTAL_REVENUE", "FQ", ignore_invalid_symbol=true)
profit = request.financial(cleanTicker, "NET_INCOME", "FQ", ignore_invalid_symbol=true)
totalShares = request.financial(cleanTicker, "TOTAL_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol=true)
floatShares = request.financial(cleanTicker, "FLOAT_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol=true)
operIncome = request.financial(cleanTicker, "OPER_INCOME", "FQ", ignore_invalid_symbol=true)

float marketCap = not na(totalShares) ? close * totalShares : na
float freeFloat = not na(floatShares) ? close * floatShares : na

//====================================================
// QUARTERLY DATA TRACKING (9 quarters)
//====================================================
CRORE = 10000000.0

var float[] q_np    = array.new_float(9, na)
var float[] q_sales = array.new_float(9, na)
var float[] q_oi    = array.new_float(9, na)
var string[] q_lbl  = array.new_string(9, "")
var float prevRev   = na
var int lastQtrBar  = 0

if not na(revenue) and (na(prevRev) or revenue != prevRev)
    array.unshift(q_np, profit)
    array.pop(q_np)
    array.unshift(q_sales, revenue)
    array.pop(q_sales)
    array.unshift(q_oi, operIncome)
    array.pop(q_oi)
    int m = month
    int y = year
    int fqM = m <= 2 ? 12 : m <= 5 ? 3 : m <= 8 ? 6 : m <= 11 ? 9 : 12
    int fqY = fqM == 12 and m <= 2 ? y - 1 : y
    string ms = fqM == 3 ? "Mar" : fqM == 6 ? "Jun" : fqM == 9 ? "Sep" : "Dec"
    array.unshift(q_lbl, ms + "-" + str.tostring(fqY % 100))
    array.pop(q_lbl)
    prevRev := revenue
    lastQtrBar := bar_index

//====================================================
// EARNINGS PROXIMITY WARNING
//====================================================
int barsSinceQtr = bar_index - lastQtrBar
bool isWeeklyTF = timeframe.isweekly
int earningsThreshLo = isWeeklyTF ? 10 : 50
int earningsThreshHi = isWeeklyTF ? 15 : 75
bool earningsSoon = lastQtrBar > 0 and barsSinceQtr >= earningsThreshLo and barsSinceQtr <= earningsThreshHi

// QoQ growth (for fundamentals table)
float salesGrowth = na
float profitGrowth = na
if not na(array.get(q_sales, 0)) and not na(array.get(q_sales, 1)) and array.get(q_sales, 1) != 0
    salesGrowth := ((array.get(q_sales, 0) - array.get(q_sales, 1)) / math.abs(array.get(q_sales, 1))) * 100
if not na(array.get(q_np, 0)) and not na(array.get(q_np, 1)) and array.get(q_np, 1) != 0
    profitGrowth := ((array.get(q_np, 0) - array.get(q_np, 1)) / math.abs(array.get(q_np, 1))) * 100

//====================================================
// EPS YoY & Revenue YoY (current quarter vs 4 quarters ago)
//====================================================
float epsYoY = na
float revYoY = na
float _np0  = array.get(q_np, 0)
float _np4  = array.size(q_np) > 4 ? array.get(q_np, 4) : na
float _sal0 = array.get(q_sales, 0)
float _sal4 = array.size(q_sales) > 4 ? array.get(q_sales, 4) : na
if not na(_np0) and not na(_np4) and _np4 != 0
    epsYoY := ((_np0 - _np4) / math.abs(_np4)) * 100
if not na(_sal0) and not na(_sal4) and _sal4 != 0
    revYoY := ((_sal0 - _sal4) / math.abs(_sal4)) * 100

//====================================================
// FINANCIAL VALIDATION FOR BEHAVIOR TYPE
//====================================================
float finGrowthBonus    = 0.0
float finCyclicalBonus  = 0.0
float finDefensiveBonus = 0.0
float finTurnaroundBonus = 0.0

int npRising  = 0
int npFalling = 0
int npSwings  = 0
bool npRecovery = false

for i = 0 to 3
    float curr = array.get(q_np, i)
    float prev = array.get(q_np, i + 1)
    if not na(curr) and not na(prev)
        if curr > prev
            npRising += 1
        else
            npFalling += 1
        if (curr > 0 and prev < 0) or (curr < 0 and prev > 0)
            npSwings += 1

float npLatest = array.get(q_np, 0)
float npOldest = array.get(q_np, 4)
if not na(npLatest) and not na(npOldest) and npLatest > 0 and npOldest < 0
    npRecovery := true

int salesRising = 0
for i = 0 to 3
    float curr = array.get(q_sales, i)
    float prev = array.get(q_sales, i + 1)
    if not na(curr) and not na(prev) and curr > prev
        salesRising += 1

finGrowthBonus := (npRising >= 3 ? 25.0 : npRising >= 2 ? 15.0 : 0.0) + (salesRising >= 3 ? 15.0 : 0.0)
finCyclicalBonus := npSwings >= 2 ? 30.0 : npSwings >= 1 ? 15.0 : 0.0
float npStability = npSwings == 0 and npFalling <= 1 ? 20.0 : 0.0
finDefensiveBonus := npStability + (salesRising <= 2 and salesRising >= 1 ? 10.0 : 0.0)
finTurnaroundBonus := npRecovery ? 35.0 : 0.0

cyclicalScore  := chartCyclical  * 0.6 + math.min(finCyclicalBonus  * 1.33, 40)
growthScore    := chartGrowth    * 0.6 + math.min(finGrowthBonus    * 1.0, 40)
defensiveScore := chartDefensive * 0.6 + math.min(finDefensiveBonus * 1.33, 40)
turnaroundScore := chartTurnaround * 0.6 + math.min(finTurnaroundBonus * 1.14, 40)

maxBehav := math.max(cyclicalScore, math.max(growthScore, math.max(defensiveScore, turnaroundScore)))
behavType := maxBehav == growthScore ? "GROWTH" : maxBehav == cyclicalScore ? "CYCLICAL" : maxBehav == turnaroundScore ? "TURNAROUND" : "DEFENSIVE"
behavClr := maxBehav == growthScore ? color.new(#00E676, 0) : maxBehav == cyclicalScore ? color.new(#2196F3, 0) : maxBehav == turnaroundScore ? color.new(#AA00FF, 0) : color.new(#9E9E9E, 0)

//====================================================
// INVESTMENT DECISION SCORE (composite 0-100)
//====================================================
float investScore = 0.0
// Stage contribution (0-30) — v4.1: stage2early gets 22 pts (between Stage 2 and Stage 1)
investScore += stage2 ? 30.0 : stage2early ? 22.0 : stage1 ? 15.0 : stage3 ? 5.0 : 0.0
// Trend template (0-25): 8 criteria × 3.125
investScore += ttScore * 3.125
// RS contribution (0-20)
investScore += not na(rsRank) ? rsRank * 0.2 : 0.0
// Behavior score (0-25)
investScore += maxBehav * 0.25

string investDecision = investScore >= 60 ? "BUY" : investScore >= 30 ? "HOLD" : "AVOID"
color investClr = investScore >= 60 ? color.new(#00E676, 0) : investScore >= 30 ? color.new(#FFD740, 0) : color.new(#FF1744, 0)
string investEmoji = investScore >= 60 ? "●" : investScore >= 30 ? "◐" : "⊙"

//====================================================
// 52W HIGH / LOW PERCENTAGES
//====================================================
float pctFrom52H = not na(high52) and high52 > 0 ? ((close - high52) / high52) * 100 : na
float pctFrom52L = not na(low52) and low52 > 0 ? ((close - low52) / low52) * 100 : na

//====================================================
// ENHANCED SUMMARY TABLE (19 rows — V2 screenshot layout)
//====================================================
var table t = table.new(f_pos(summaryPos), 2, 19, border_width=1)

if barstate.islast

    // Theme colors
    color hdrBg = color.new(#1a1a2e, 0)
    color lblBg = color.new(#16213e, 0)
    color txtW  = color.white

    // --- Row 0: Ticker (header) ---
    table.cell(t, 0, 0, "Ticker", text_color=color.gray, bgcolor=hdrBg, text_size=fontSize)
    table.cell(t, 1, 0, syminfo.ticker, text_color=color.new(#FFD740, 0), bgcolor=hdrBg, text_size=fontSize)

    // --- Row 1: Stage ---
    table.cell(t, 0, 1, "Stage", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 1, stageText + " " + stageEmoji, text_color=txtW, bgcolor=stageColor, text_size=fontSize)

    // --- Row 2: Trend Template (0/8) ---
    color ttClr = ttScore >= 7 ? color.new(#00E676, 20) : ttScore >= 5 ? color.new(color.green, 60) : ttScore >= 3 ? color.new(#FF9100, 40) : color.new(#FF1744, 40)
    table.cell(t, 0, 2, "Trend Tmpl", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 2, str.tostring(ttScore) + "/8", text_color=txtW, bgcolor=ttClr, text_size=fontSize)

    // --- Row 3: RS vs Index ---
    bool rsUp = not na(rs) and not na(rsEMA) and rs > rsEMA
    string rsDir = rsUp ? "▲" : "▼"
    color rsIdxClr = rsUp ? color.new(#00E676, 40) : color.new(#FF1744, 40)
    table.cell(t, 0, 3, "RS vs Idx", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 3, na(rs) ? "N/A" : rsDir + " " + str.tostring(rs, "#.##"), text_color=txtW, bgcolor=na(rs) ? color.new(color.gray, 80) : rsIdxClr, text_size=fontSize)

    // --- Row 4: RS vs Sector ---
    bool rsSecUp = not na(rsSec) and not na(rsSecEMA) and rsSec > rsSecEMA
    string rsSecDir = rsSecUp ? "▲" : "▼"
    color rsSecClr = rsSecUp ? color.new(#00E676, 40) : color.new(#FF1744, 40)
    table.cell(t, 0, 4, "RS vs Sec", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 4, na(rsSec) ? "N/A" : rsSecDir + " " + str.tostring(rsSec, "#.##"), text_color=txtW, bgcolor=na(rsSec) ? color.new(color.gray, 80) : rsSecClr, text_size=fontSize)

    // --- Row 5: Mansfield RS ---
    color mfClr = na(mansfield) ? color.new(color.gray, 80) : mansfield > 0 ? color.new(#00E676, 40) : color.new(#FF1744, 40)
    table.cell(t, 0, 5, "Mansfield", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 5, na(mansfield) ? "N/A" : str.tostring(mansfield, "#.#") + "%", text_color=txtW, bgcolor=mfClr, text_size=fontSize)

    // --- Row 6: Weekly RS ---
    color wrsClr = weeklyRSup ? color.new(#00E676, 40) : color.new(#FF1744, 40)
    table.cell(t, 0, 6, "Weekly RS", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 6, na(rs) ? "N/A" : weeklyRSup ? "▲ rising" : "▼ falling", text_color=txtW, bgcolor=na(rs) ? color.new(color.gray, 80) : wrsClr, text_size=fontSize)

    // --- Row 7: 52W High / Low % ---
    string h52Str = na(pctFrom52H) ? "NaN%" : str.tostring(pctFrom52H, "#") + "%"
    string l52Str = na(pctFrom52L) ? "NaN%" : str.tostring(pctFrom52L, "#") + "%"
    color hl52Clr = not na(pctFrom52H) and pctFrom52H >= 0 ? color.new(#00E676, 40) : color.new(color.gray, 70)
    table.cell(t, 0, 7, "52W H/L", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 7, "|" + h52Str + " |" + l52Str, text_color=txtW, bgcolor=hl52Clr, text_size=fontSize)

    // --- Row 8: Behavior (BUY/HOLD/AVOID with composite score) ---
    table.cell(t, 0, 8, "Behavior", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 8, investEmoji + " " + investDecision + " " + str.tostring(investScore, "#") + "/100", text_color=txtW, bgcolor=investClr, text_size=fontSize)

    // --- Row 9: Position ---
    table.cell(t, 0, 9, "Position", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 9, posEmoji + " " + posState, text_color=txtW, bgcolor=posClr, text_size=fontSize)

    // --- Row 10: Entry / Stop ---
    string esText = posState == "NONE" ? "—" : not na(entryPrice) and not na(entryStop) ? str.tostring(entryPrice, "#.##") + " / " + str.tostring(entryStop, "#.##") : "—"
    color esClr = posState == "NONE" ? color.new(color.gray, 80) : color.new(#2196F3, 60)
    table.cell(t, 0, 10, "Entry/Stop", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 10, esText, text_color=txtW, bgcolor=esClr, text_size=fontSize)

    // --- Row 11: Risk/R ---
    string rrText = posState == "NONE" ? "—" : na(riskPct) ? "N/A" : "Risk " + str.tostring(riskPct, "#.#") + "%" + (not na(currentR) ? " | " + str.tostring(currentR, "#.#") + "R" : "")
    color rrClr = posState == "NONE" ? color.new(color.gray, 80) : not na(currentR) and currentR >= 2 ? color.new(#00E676, 40) : not na(currentR) and currentR >= 1 ? color.new(color.green, 60) : not na(currentR) and currentR >= 0 ? color.new(color.gray, 70) : color.new(color.red, 60)
    table.cell(t, 0, 11, "Risk/R", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 11, rrText, text_color=txtW, bgcolor=rrClr, text_size=fontSize)

    // --- Row 12: Sizing ---
    string sizText = posState == "NONE" or na(sharesSize) ? "—" : str.tostring(sharesSize, "#") + " sh · ₹" + str.tostring(riskValueK, "#.#") + "k risk"
    color sizClr = posState == "NONE" or na(sharesSize) ? color.new(color.gray, 80) : color.new(#2196F3, 60)
    table.cell(t, 0, 12, "Sizing", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 12, sizText, text_color=txtW, bgcolor=sizClr, text_size=fontSize)

    // --- Row 13: Pyramid ---
    table.cell(t, 0, 13, "Pyramid", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 13, str.tostring(pyramidCount) + "/" + str.tostring(maxPyramidInput) + " adds", text_color=txtW, bgcolor=color.new(color.gray, 80), text_size=fontSize)

    // --- Row 14: ATR % ---
    color atrClr = atrPct > 6 ? color.new(#FF9100, 40) : atrPct > 3 ? color.new(#FFD740, 50) : color.new(color.green, 60)
    table.cell(t, 0, 14, "ATR %", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 14, str.tostring(atrPct, "#.#") + "%", text_color=txtW, bgcolor=atrClr, text_size=fontSize)

    // --- Row 15: Vol Surge ---
    bool hasVolSurge = volSurgeRatio >= 1.5
    string vsText = hasVolSurge ? str.tostring(volSurgeRatio, "#.#") + "x" : "—"
    color vsClr = hasVolSurge ? color.new(#00E676, 40) : color.new(color.gray, 80)
    table.cell(t, 0, 15, "Vol Surge", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 15, vsText, text_color=txtW, bgcolor=vsClr, text_size=fontSize)

    // --- Row 16: EPS YoY ---
    color epsClr = na(epsYoY) ? color.new(color.gray, 80) : epsYoY > 0 ? color.new(#00E676, 40) : color.new(#FF1744, 40)
    table.cell(t, 0, 16, "EPS YoY", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 16, na(epsYoY) ? "N/A" : str.tostring(epsYoY, "#") + "%", text_color=txtW, bgcolor=epsClr, text_size=fontSize)

    // --- Row 17: Rev YoY ---
    color revClr = na(revYoY) ? color.new(color.gray, 80) : revYoY > 0 ? color.new(#00E676, 40) : color.new(#FF1744, 40)
    table.cell(t, 0, 17, "Rev YoY", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 17, na(revYoY) ? "N/A" : str.tostring(revYoY, "#") + "%", text_color=txtW, bgcolor=revClr, text_size=fontSize)

    // --- Row 18: Earnings ---
    string earnText = earningsSoon ? "⚠ soon" : lastQtrBar > 0 ? "ok" : "—"
    color earnClr = earningsSoon ? color.new(#FF9100, 40) : lastQtrBar > 0 ? color.new(color.green, 60) : color.new(color.gray, 80)
    table.cell(t, 0, 18, "Earnings", text_color=txtW, bgcolor=lblBg, text_size=fontSize)
    table.cell(t, 1, 18, earnText, text_color=txtW, bgcolor=earnClr, text_size=fontSize)

//====================================================
// FUNDAMENTALS TABLE
//====================================================
var table ft = table.new(f_pos(fundPos), 8, 9, border_width=0)

if barstate.islast
    color hdrBg2  = color.new(#1a1a2e, 0)
    color rowBg1 = color.new(#16213e, 0)
    color rowBg2 = color.new(#0f3460, 0)
    color txtW2   = color.white

    float mcCr = na(marketCap) ? na : marketCap / CRORE
    string capType = na(mcCr) ? "" : mcCr >= 20000 ? " · Large Cap" : mcCr >= 5000 ? " · Mid Cap" : mcCr >= 1000 ? " · Small Cap" : " · Micro Cap"
    color capClr   = na(mcCr) ? color.yellow : mcCr >= 20000 ? color.new(#00E676, 0) : mcCr >= 5000 ? color.new(#FFD740, 0) : mcCr >= 1000 ? color.new(#FF9100, 0) : color.new(#FF5252, 0)

    string mcStr = na(marketCap) ? "N/A" : str.tostring(marketCap / CRORE, "#,###") + " Cr"
    table.cell(ft, 0, 0, "Mkt Cap: " + mcStr + capType, text_color=capClr, bgcolor=hdrBg2, text_size=fontSize, text_halign=text.align_center)
    for c = 1 to 7
        table.cell(ft, c, 0, "", bgcolor=hdrBg2)
    table.merge_cells(ft, 0, 0, 7, 0)

    table.cell(ft, 0, 1, syminfo.sector, text_color=color.new(color.aqua, 0), bgcolor=hdrBg2, text_size=fontSize, text_halign=text.align_center)
    table.cell(ft, 1, 1, "", bgcolor=hdrBg2)
    table.cell(ft, 2, 1, "", bgcolor=hdrBg2)
    table.cell(ft, 3, 1, "", bgcolor=hdrBg2)
    table.cell(ft, 4, 1, syminfo.industry, text_color=color.new(color.aqua, 0), bgcolor=hdrBg2, text_size=fontSize, text_halign=text.align_center)
    table.cell(ft, 5, 1, "", bgcolor=hdrBg2)
    table.cell(ft, 6, 1, "", bgcolor=hdrBg2)
    table.cell(ft, 7, 1, "", bgcolor=hdrBg2)
    table.merge_cells(ft, 0, 1, 3, 1)
    table.merge_cells(ft, 4, 1, 7, 1)

    string[] hdrs = array.from("FQ", "NP", "YoY", "QoQ", "Sales", "YoY", "QoQ", "OPM")
    for c = 0 to 7
        table.cell(ft, c, 2, array.get(hdrs, c), text_color=txtW2, bgcolor=color.new(#533483, 0), text_size=fontSize)

    for row = 0 to 4
        int r = row + 3
        color rBg = row % 2 == 0 ? rowBg1 : rowBg2

        string lbl = array.get(q_lbl, row)
        float np   = array.get(q_np, row)
        float sal  = array.get(q_sales, row)
        float oi   = array.get(q_oi, row)

        float np4  = row + 4 < 9 ? array.get(q_np, row + 4) : na
        float sal4 = row + 4 < 9 ? array.get(q_sales, row + 4) : na
        float np1  = row + 1 < 9 ? array.get(q_np, row + 1) : na
        float sal1 = row + 1 < 9 ? array.get(q_sales, row + 1) : na

        float npYoY  = not na(np) and not na(np4) and np4 != 0 ? ((np - np4) / math.abs(np4)) * 100 : na
        float npQoQ  = not na(np) and not na(np1) and np1 != 0 ? ((np - np1) / math.abs(np1)) * 100 : na
        float salYoY = not na(sal) and not na(sal4) and sal4 != 0 ? ((sal - sal4) / math.abs(sal4)) * 100 : na
        float salQoQ = not na(sal) and not na(sal1) and sal1 != 0 ? ((sal - sal1) / math.abs(sal1)) * 100 : na
        float opm    = not na(oi) and not na(sal) and sal != 0 ? (oi / sal) * 100 : na

        color npYoYbg  = na(npYoY)  ? rBg : npYoY  > 0 ? color.new(#00C853, 40) : color.new(#FF1744, 40)
        color npQoQbg  = na(npQoQ)  ? rBg : npQoQ  > 0 ? color.new(#00C853, 40) : color.new(#FF1744, 40)
        color salYoYbg = na(salYoY) ? rBg : salYoY > 0 ? color.new(#00C853, 40) : color.new(#FF1744, 40)
        color salQoQbg = na(salQoQ) ? rBg : salQoQ > 0 ? color.new(#00C853, 40) : color.new(#FF1744, 40)

        table.cell(ft, 0, r, lbl != "" ? lbl : "--", text_color=txtW2, bgcolor=rBg, text_size=fontSize)
        table.cell(ft, 1, r, na(np) ? "--" : str.tostring(np / CRORE, "#"), text_color=txtW2, bgcolor=rBg, text_size=fontSize)
        table.cell(ft, 2, r, na(npYoY) ? "--" : str.tostring(npYoY, "#") + "%", text_color=txtW2, bgcolor=npYoYbg, text_size=fontSize)
        table.cell(ft, 3, r, na(npQoQ) ? "--" : str.tostring(npQoQ, "#") + "%", text_color=txtW2, bgcolor=npQoQbg, text_size=fontSize)
        table.cell(ft, 4, r, na(sal) ? "--" : str.tostring(sal / CRORE, "#"), text_color=txtW2, bgcolor=rBg, text_size=fontSize)
        table.cell(ft, 5, r, na(salYoY) ? "--" : str.tostring(salYoY, "#") + "%", text_color=txtW2, bgcolor=salYoYbg, text_size=fontSize)
        table.cell(ft, 6, r, na(salQoQ) ? "--" : str.tostring(salQoQ, "#") + "%", text_color=txtW2, bgcolor=salQoQbg, text_size=fontSize)
        table.cell(ft, 7, r, na(opm) ? "--" : str.tostring(opm, "#.#") + "%", text_color=txtW2, bgcolor=rBg, text_size=fontSize)

//====================================================
// INSIDER / INSTITUTIONAL ACTIVITY DETECTOR
//====================================================
volRatio     = volume / volMA
priceRange   = high - low
closePos     = priceRange > 0 ? (close - low) / priceRange : 0.5

accumulation = volRatio > 2.0 and closePos > 0.6 and close > close[1]
distribution = volRatio > 2.0 and closePos < 0.4 and close < close[1]
stealth      = ta.sma(volume, 5) > volMA * 1.5 and math.abs(close - close[5]) / atr < 0.5 and close > ema50

accum_trigger = accumulation and not accumulation[1]
dist_trigger  = distribution and not distribution[1]
stealth_trigger = stealth and not stealth[1]

plotshape(showInsider and accum_trigger and trendOk, title="Accumulation", text="ACC", style=shape.labelup, location=location.belowbar, color=color.new(#00E676, 0), textcolor=color.black, size=size.small)
plotshape(showInsider and dist_trigger, title="Distribution", text="DIST", style=shape.labeldown, location=location.abovebar, color=color.new(#FF1744, 0), textcolor=color.white, size=size.small)
plotshape(showInsider and stealth_trigger and trendOk, title="Stealth Accumulation", text="🕵", style=shape.labelup, location=location.belowbar, color=color.new(#7C4DFF, 0), textcolor=color.white, size=size.small)

//====================================================
// SIGNAL LEGEND TABLE
//====================================================
var table legend = na

if showLegend and barstate.islast
    legend := table.new(f_pos(legendPos), 2, 32, border_width=0)
    color lBg  = color.new(#1a1a2e, 10)
    color lBg2 = color.new(#0f3460, 10)
    color lHdr = color.new(#533483, 0)
    color lSec = color.new(#1B5E20, 0)
    color lNew = color.new(#0D47A1, 0)

    table.cell(legend, 0, 0, "Signal", text_color=color.white, bgcolor=lHdr, text_size=legendSize)
    table.cell(legend, 1, 0, "How to Read", text_color=color.white, bgcolor=lHdr, text_size=legendSize)

    // Buy Signals
    table.cell(legend, 0, 1, "🟢 A", text_color=color.green, bgcolor=lBg, text_size=legendSize)
