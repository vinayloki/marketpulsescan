//====================================================
// ALERTS
//====================================================
alertcondition(strongBuy and trendOk, title="STRONG BUY", message="🚀 STRONG BUY — {{ticker}} score 70+ in trending regime")
alertcondition(showA, title="BUY A", message="BUY A — {{ticker}} trend breakout")
alertcondition(showB, title="BUY B", message="BUY B — {{ticker}} Donchian breakout")
alertcondition(showC, title="BUY C", message="BUY C — {{ticker}} 52W high breakout")
alertcondition(sellX, title="SELL X", message="SELL X — {{ticker}} below EMA20 + weak RSI")
alertcondition(sellY, title="SELL Y", message="SELL Y — {{ticker}} below EMA50 + RS weakness")
alertcondition(sellZ, title="SELL Z", message="SELL Z — {{ticker}} below EMA200 + strong ADX")

alertcondition(posState == "ENTRY" and posState[1] == "NONE", title="POSITION: ENTRY", message="🟢 ENTRY — {{ticker}} new position")
alertcondition(posState == "ADD" and posState[1] != "ADD", title="POSITION: ADD", message="🟢 ADD — {{ticker}} pyramid add")
alertcondition(posState == "TIGHTEN" and posState[1] != "TIGHTEN", title="POSITION: TIGHTEN", message="🟡 TIGHTEN — {{ticker}} tighten stops")
alertcondition(posState == "REDUCE" and posState[1] != "REDUCE", title="POSITION: REDUCE", message="🟠 REDUCE — {{ticker}} reduce position")
alertcondition(posState == "EXIT" and posState[1] != "EXIT", title="POSITION: EXIT", message="🔴 EXIT — {{ticker}} exit position")
alertcondition(showVCP and vcpTrigger, title="VCP SETUP", message="🔷 VCP — {{ticker}} Volatility Contraction in Stage 2/2E")
alertcondition(earningsSoon and not earningsSoon[1], title="EARNINGS WARNING", message="⚠ EARNINGS — {{ticker}} results imminent")
// v4.1: Alert for Stage 2 Early transition
alertcondition(stage2early and not stage2early[1], title="STAGE 2E ENTRY", message="◐ STAGE 2E — {{ticker}} EMA200 turning up, early advance")
